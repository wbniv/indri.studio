---
import { erawanMotionPatterns } from "../data/erawan-motion";
---

<erawan-motion>
	<div class="e-motion-backdrop" aria-hidden="true">
		{["left", "right"].map((side) => (
		<svg class={`e-motion-side e-motion-${side}`} viewBox="300 0 240 310" preserveAspectRatio="xMidYMid slice" focusable="false">
			{erawanMotionPatterns.map((pattern) => (
				<g data-pattern={pattern.id} hidden>
					{pattern.shapes.map((shape, i) => (
						<g class="e-motion-opacity" style={`--alpha:${pattern.alpha}`}>
							<g class={`e-motion-piece e-motion-${pattern.kind}`} style={`--duration:${pattern.duration + i * 2}s;--dx:${pattern.dx * (i % 2 ? -1 : 1)}px;--dy:${pattern.dy * (i % 2 ? -1 : 1)}px;--delay:-${pattern.duration / 8 + i * pattern.duration / 4}s;`} set:html={shape} />
						</g>
					))}
				</g>
			))}
		</svg>
		))}
	</div>
	<details class="e-motion-controls" hidden>
		<summary>Background <span class="e-motion-selection">· P13</span></summary>
		<div class="e-motion-panel">
		<div class="e-motion-fields">
			<label for="e-background">Background
				<select id="e-background">
					<option value="none">None</option>
					{erawanMotionPatterns.map((pattern) => <option value={pattern.id} selected={pattern.id === "P13"}>{pattern.id} · {pattern.name}</option>)}
				</select>
			</label>
			<label for="e-motion-strength">Motion
				<select id="e-motion-strength"><option value="subtle">Subtle</option><option value="emphasized">Emphasized</option></select>
			</label>
			<button type="button" class="e-motion-toggle" aria-pressed="false">Play motion</button>
		</div>
		<p class="e-motion-status" role="status" aria-live="polite"></p>
		</div>
	</details>
</erawan-motion>

<script>
	class ErawanMotion extends HTMLElement {
		connectedCallback() {
			const select = this.querySelector<HTMLSelectElement>("#e-background")!;
			const strength = this.querySelector<HTMLSelectElement>("#e-motion-strength")!;
			const toggle = this.querySelector<HTMLButtonElement>(".e-motion-toggle")!;
			const status = this.querySelector<HTMLElement>(".e-motion-status")!;
			const controls = this.querySelector<HTMLElement>(".e-motion-controls")!;
			const page = this.closest<HTMLElement>(".erawan")!;
			const patterns = [...this.querySelectorAll<SVGGElement>("[data-pattern]")];
			const preference = matchMedia("(prefers-reduced-motion: reduce)");
			const key = "erawan-background-study";
			const abort = new AbortController();
			const { signal } = abort;
			let requestedPlay = true;
			let optedIn = false;
			let visible = false;
			let stored = false;
			try {
				const saved = JSON.parse(localStorage.getItem(key) || "null");
				if (saved && [...select.options].some(option => option.value === saved.pattern)) {
					select.value = saved.pattern;
					strength.value = saved.strength === "emphasized" ? "emphasized" : "subtle";
					requestedPlay = saved.paused !== true;
					stored = true;
				}
			} catch { /* Blocked storage and invalid JSON leave the preview usable. */ }
			const save = () => {
				try {
					localStorage.setItem(key, JSON.stringify({pattern: select.value, strength: strength.value, paused: !requestedPlay}));
					stored = true;
				} catch { stored = false; }
			};
			const update = () => {
				const none = select.value === "none";
				const reduced = preference.matches && !optedIn;
				const enabled = !none && requestedPlay && !reduced;
				this.dataset.playing = String(enabled && visible && !document.hidden);
				this.dataset.inView = String(visible);
				this.querySelector(".e-motion-selection")!.textContent = `· ${none ? "None" : select.value}`;
				this.dataset.strength = strength.value;
				this.dataset.motionOptIn = String(optedIn);
				patterns.forEach(pattern => pattern.toggleAttribute("hidden", pattern.dataset.pattern !== select.value));
				toggle.disabled = none;
				toggle.textContent = reduced && !none ? "Play this preview" : enabled ? "Pause motion" : "Play motion";
				toggle.setAttribute("aria-pressed", String(enabled));
				const state = none ? "No decorative background." : reduced ? "Reduced motion: still preview. Play to animate this visit." : !requestedPlay ? "Paused." : !visible || document.hidden ? "Motion pauses while out of view." : "Playing.";
				const mode = none ? "" : strength.value === "emphasized" ? " Emphasized for comparison." : " Subtle motion.";
				status.textContent = `${state}${mode}${stored ? " Choice saved in this browser." : ""}`;
			};
			select.addEventListener("change", () => {save(); update();}, {signal});
			strength.addEventListener("change", () => {save(); update();}, {signal});
			toggle.addEventListener("click", () => {
				if (preference.matches && !optedIn) {optedIn = true; requestedPlay = true;}
				else requestedPlay = !requestedPlay;
				save(); update();
			}, {signal});
			preference.addEventListener("change", () => {optedIn = false; update();}, {signal});
			document.addEventListener("visibilitychange", update, {signal});
			const observer = new IntersectionObserver(entries => {
				visible = entries.some(entry => entry.isIntersecting);
				update();
			});
			observer.observe(page);
			controls.hidden = false;
			update();
			this.dataset.ready = "true";
			this.cleanup = () => {abort.abort(); observer.disconnect();};
		}
		cleanup?: () => void;
		disconnectedCallback() {this.cleanup?.();}
	}
	if (!customElements.get("erawan-motion")) customElements.define("erawan-motion", ErawanMotion);
</script>

<style is:global>
	erawan-motion { display: contents; --e-motion-speed: 1; --e-motion-travel: 1; --e-motion-strength: 1; }
	erawan-motion[data-strength="emphasized"] { --e-motion-speed: .25; --e-motion-travel: 3; --e-motion-strength: 3; }
	erawan-motion .e-motion-backdrop { position: fixed; inset: 0; display: flex; pointer-events: none; overflow: hidden; z-index: 0; mask-image: linear-gradient(90deg, black 10%, transparent 48%, transparent 52%, black 90%); }
	erawan-motion[data-in-view="false"] .e-motion-backdrop { visibility: hidden; }
	erawan-motion .e-motion-backdrop svg { display: block; width: 50%; height: 100%; }
	erawan-motion .e-motion-left { transform: scaleX(-1); }
	erawan-motion [hidden] { display: none !important; }
	erawan-motion .e-motion-opacity { opacity: calc(var(--alpha) * var(--e-motion-strength)); }
	erawan-motion .e-motion-piece { animation-duration: calc(var(--duration) * var(--e-motion-speed)); animation-delay: var(--delay); animation-timing-function: ease-in-out; animation-iteration-count: infinite; animation-play-state: paused; }
	erawan-motion[data-playing="true"] [data-pattern]:not([hidden]) .e-motion-piece { animation-play-state: running; }
	erawan-motion .e-motion-drift { animation-name: erawan-drift; }
	erawan-motion .e-motion-pulse { animation-name: erawan-pulse; }
	erawan-motion .e-motion-dash { animation-name: erawan-dash; animation-timing-function: linear; }
	@keyframes erawan-drift { 0%,100% { transform: translate(0,0); } 50% { transform: translate(calc(var(--dx)*var(--e-motion-travel)),calc(var(--dy)*var(--e-motion-travel))); } }
	@keyframes erawan-pulse { 0%,100% { opacity: .5; } 50% { opacity: 1; } }
	@keyframes erawan-dash { 0%,100% { stroke-dashoffset: 0; } 50% { stroke-dashoffset: calc(var(--dx)*var(--e-motion-travel)); } }
	erawan-motion .e-motion-controls { position: fixed; bottom: 16px; left: 16px; z-index: 40; max-width: min(680px, calc(100vw - 32px)); border: 1px solid var(--color-outline); border-radius: 10px; background: var(--e-card); }
	erawan-motion summary { padding: 12px 16px; min-height: 44px; cursor: pointer; font-size: 14px; color: var(--e-ink); }
	erawan-motion summary:focus-visible { outline: 3px solid var(--e-accent); outline-offset: 3px; border-radius: 10px; }
	erawan-motion .e-motion-selection { color: var(--e-muted); }
	erawan-motion .e-motion-panel { padding: 0 16px 14px; max-height: 55svh; overflow: auto; }
	.erawan { position: relative; isolation: isolate; z-index: 1; }
	.erawan > :not(erawan-motion) { position: relative; z-index: 1; }
	erawan-motion .e-motion-fields { display: flex; align-items: end; flex-wrap: wrap; gap: 12px 20px; }
	erawan-motion label { display: flex; align-items: center; gap: 10px; font-size: 14px; color: var(--e-muted); }
	erawan-motion select, erawan-motion button { min-height: 44px; max-width: 100%; padding: 8px 12px; border: 1px solid var(--color-outline); border-radius: 6px; background: var(--e-btn); color: var(--e-ink); font: inherit; }
	erawan-motion button { cursor: pointer; }
	erawan-motion button:disabled { opacity: .5; cursor: default; }
	erawan-motion select:focus-visible, erawan-motion button:focus-visible { outline: 3px solid var(--e-accent); outline-offset: 3px; }
	erawan-motion .e-motion-status { margin: 10px 0 0; font-size: 13px; color: var(--e-muted); }
	@media (max-width: 700px) {
		erawan-motion { --e-motion-travel: .5; }
		erawan-motion[data-strength="emphasized"] { --e-motion-travel: 1.5; }
		erawan-motion .e-motion-fields { align-items: stretch; gap: 10px; }
		erawan-motion label { display: grid; gap: 4px; }
		erawan-motion label:first-child { flex-basis: 100%; }
		erawan-motion .e-motion-toggle { align-self: end; }
	}
	@media (prefers-reduced-motion: reduce) { erawan-motion:not([data-motion-opt-in="true"]) .e-motion-piece { animation: none !important; } }
</style>
