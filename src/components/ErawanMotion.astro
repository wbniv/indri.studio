---
import { erawanMotionPattern as pattern } from "../data/erawan-motion";
---

<erawan-motion>
	<div class="e-motion-backdrop" aria-hidden="true">
		{["left", "right"].map((side) => (
		<svg class={`e-motion-side e-motion-${side}`} focusable="false">
			<defs>
			<pattern id={`e-motion-tile-${side}`} width="100%" height="800" patternUnits="userSpaceOnUse" viewBox="300 0 240 310" preserveAspectRatio="xMidYMid slice">
				<g data-pattern={pattern.id}>
					{pattern.shapes.map((shape, i) => (
						<g class="e-motion-opacity" style={`--alpha:${pattern.alpha}`}>
							<g class={`e-motion-piece e-motion-${pattern.kind}`} style={`--duration:${pattern.duration + i * 2}s;--dx:${pattern.dx * (i % 2 ? -1 : 1)}px;--dy:${pattern.dy * (i % 2 ? -1 : 1)}px;--delay:-${pattern.duration / 8 + i * pattern.duration / 4}s;`} set:html={shape} />
						</g>
					))}
				</g>
			</pattern>
			</defs>
			<rect width="100%" height="100%" fill={`url(#e-motion-tile-${side})`} />
		</svg>
		))}
	</div>
</erawan-motion>

<script>
 class ErawanMotion extends HTMLElement {
  connectedCallback() {
   const page = this.closest<HTMLElement>(".erawan")!;
   const preference = matchMedia("(prefers-reduced-motion: reduce)");
   const abort = new AbortController();
   const { signal } = abort;
   let visible = false;
   const update = () => { this.dataset.playing = String(visible && !document.hidden && !preference.matches); };
   preference.addEventListener("change", update, {signal});
   document.addEventListener("visibilitychange", update, {signal});
   const observer = new IntersectionObserver(entries => {
    visible = entries.some(entry => entry.isIntersecting);
    update();
   });
   observer.observe(page);
   update();
   this.dataset.ready = "true";
   this.cleanup = () => {abort.abort(); observer.disconnect();};
  }
  cleanup?: () => void;
  disconnectedCallback() {this.cleanup?.();}
 }
 if (!customElements.get("erawan-motion")) customElements.define("erawan-motion", ErawanMotion);
</script>

<style is:global>
	erawan-motion { display: contents; --e-motion-speed: .25; --e-motion-travel: 3; --e-motion-strength: 3; }
	erawan-motion .e-motion-backdrop { position: absolute; inset: 0; display: flex; pointer-events: none; overflow: hidden; z-index: 0; mask-image: linear-gradient(90deg, black 10%, transparent 48%, transparent 52%, black 90%); }
	erawan-motion .e-motion-backdrop svg { display: block; width: 50%; height: 100%; }
	erawan-motion .e-motion-left { transform: scaleX(-1); }
	erawan-motion .e-motion-opacity { opacity: calc(var(--alpha) * var(--e-motion-strength)); }
	erawan-motion .e-motion-piece { animation-duration: calc(var(--duration) * var(--e-motion-speed)); animation-delay: var(--delay); animation-timing-function: ease-in-out; animation-iteration-count: infinite; animation-play-state: paused; }
	erawan-motion[data-playing="true"] .e-motion-piece { animation-play-state: running; }
	erawan-motion .e-motion-drift { animation-name: erawan-drift; }
	@keyframes erawan-drift { 0%,100% { transform: translate(0,0); } 50% { transform: translate(calc(var(--dx)*var(--e-motion-travel)),calc(var(--dy)*var(--e-motion-travel))); } }
	.erawan > :not(erawan-motion) { position: relative; z-index: 1; }
	.erawan { position: relative; isolation: isolate; z-index: 1; --e-simulation-opacity: 75%; }
	@media (max-width: 700px) { erawan-motion { --e-motion-travel: 1.5; } }
	@media (prefers-reduced-motion: reduce) { erawan-motion .e-motion-piece { animation: none !important; } }
</style>
