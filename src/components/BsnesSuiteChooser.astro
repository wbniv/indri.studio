---
import { readFileSync } from 'node:fs';

const projectRoot = process.cwd();
const romManifest = JSON.parse(readFileSync(`${projectRoot}/public/apps/llvm-mos-65816/play/roms/manifest.json`, 'utf8'));
const bundleManifest = JSON.parse(readFileSync(`${projectRoot}/public/apps/llvm-mos-65816/play/component/manifest.json`, 'utf8'));
const frame = `/apps/llvm-mos-65816/play/component/bundles/${bundleManifest.bundleId}/frame.html`;
---
<section class="wasm-suite" aria-label="WASM version of the LLVM 65816 suite APK">
  <header class="suite-header">
    <div>
      <p class="suite-kicker">WASM suite player</p>
      <h4>LLVM 65816 torture-test suite</h4>
    </div>
    <p id="suite-status" role="status" aria-live="polite">Choose a test ROM to start.</p>
  </header>
  <div class="suite-body">
    <nav class="rom-chooser" aria-label="Choose a torture-test ROM">
      <h5>Choose a test</h5>
      <ul>
        {romManifest.roms.map((rom) => <li><button type="button" data-game={rom.id}>{rom.title}</button></li>)}
      </ul>
    </nav>
    <div class="suite-screen">
      <p class="screen-prompt">Select a test from the chooser to run it in the SNES emulator.</p>
      <iframe title="SNES torture-test ROM player" loading="lazy" allow="fullscreen; autoplay; gamepad" allowfullscreen hidden></iframe>
    </div>
  </div>
</section>

<script define:vars={{ frame }}>
  const app = document.currentScript?.closest('.wasm-suite') || document.querySelector('.wasm-suite');
  const frameEl = app?.querySelector('iframe');
  const prompt = app?.querySelector('.screen-prompt');
  const status = app?.querySelector('#suite-status');
  app?.querySelectorAll('[data-game]').forEach((button) => {
    button.addEventListener('click', () => {
      const slug = button.dataset.game;
      if (!slug || !frameEl) return;
      app.querySelectorAll('[data-game]').forEach((item) => item.setAttribute('aria-current', 'false'));
      button.setAttribute('aria-current', 'true');
      frameEl.src = `${frame}?game=${encodeURIComponent(slug)}`;
      frameEl.title = `${button.textContent.trim()} running in the SNES emulator`;
      frameEl.hidden = false;
      prompt.hidden = true;
      status.textContent = `Running ${button.textContent.trim()}`;
    });
  });
</script>

<style>
  .wasm-suite { width:100%; margin:1.5rem 0 1rem; overflow:hidden; border:1px solid #625e58; border-radius:.8rem; background:#181715; color:#f2eee8; }
  .suite-header { display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:1rem 1.15rem; border-bottom:1px solid #625e58; }
  .suite-kicker { margin:0 0 .25rem; color:#b8f400; font-size:.7rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; }
  .suite-header h4 { margin:0; font-size:1.1rem; }
  #suite-status { margin:0; color:#c4beb6; font-size:.85rem; text-align:right; }
  .suite-body { display:grid; grid-template-columns:minmax(14rem, .34fr) minmax(0, .66fr); min-height:29rem; }
  .rom-chooser { min-width:0; border-right:1px solid #625e58; }
  .rom-chooser h5 { position:sticky; top:0; z-index:1; margin:0; padding:.75rem 1rem; background:#24221f; color:#c4beb6; font-size:.75rem; letter-spacing:.08em; text-transform:uppercase; }
  .rom-chooser ul { max-height:33rem; margin:0; padding:.25rem; overflow:auto; list-style:none; }
  .rom-chooser button { display:block; width:100%; padding:.65rem .75rem; border:0; border-radius:.4rem; background:transparent; color:#f2eee8; font:inherit; font-size:.9rem; text-align:left; cursor:pointer; }
  .rom-chooser button:hover, .rom-chooser button:focus-visible { outline:2px solid #b8f400; outline-offset:-2px; background:#302d29; }
  .rom-chooser button[aria-current="true"] { background:#3c4227; color:#d4ff24; }
  .suite-screen { display:grid; place-items:center; min-width:0; min-height:29rem; background:#111820; }
  .screen-prompt { max-width:22rem; padding:1rem; color:#c4beb6; text-align:center; }
  .suite-screen iframe { display:block; width:100%; height:100%; min-height:29rem; border:0; background:#111820; }
  @media(max-width:700px) {
    .suite-header { align-items:flex-start; flex-direction:column; }
    #suite-status { text-align:left; }
    .suite-body { grid-template-columns:minmax(0,1fr); }
    .rom-chooser { border-right:0; border-bottom:1px solid #625e58; }
    .rom-chooser ul { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); max-height:15rem; }
    .suite-screen, .suite-screen iframe { min-height:22rem; }
  }
</style>
