---
import { readFileSync } from 'node:fs';

const projectRoot = process.cwd();
const bundleManifest = JSON.parse(readFileSync(`${projectRoot}/public/apps/llvm-mos-65816/play/component/manifest.json`, 'utf8'));
const frame = `/apps/llvm-mos-65816/play/component/bundles/${bundleManifest.bundleId}/frame.html`;
---
<section class="suite-chooser" aria-label="By-Value Boundary Trio browser preview">
  <div class="preview-heading">
    <div>
      <h4>By-Value Boundary Trio</h4>
      <p>The APK opens the in-app suite chooser. This is a fixed browser preview of one test ROM.</p>
    </div>
  </div>
  <iframe src={`${frame}?game=byvaledge`} title="By-Value Boundary Trio running in the SNES emulator" loading="lazy" allow="fullscreen; autoplay; gamepad" allowfullscreen></iframe>
</section>

<style>
  .suite-chooser { width:100%; margin:1.5rem 0 1rem; overflow:hidden; border:1px solid #625e58; border-radius:.8rem; background:#181715; }
  .preview-heading { padding:1rem 1.15rem; }
  .preview-heading h4 { margin:0; color:#f2eee8; font-size:1.1rem; }
  .preview-heading p { margin:.25rem 0 0; color:#c4beb6; font-size:.9rem; }
  .suite-chooser iframe { display:block; width:100%; height:min(75vh, 720px); min-height:28rem; border:0; border-top:1px solid #625e58; background:#111820; }
  @media(max-width:680px) { .suite-chooser iframe { height:65vh; min-height:24rem; } }
</style>
