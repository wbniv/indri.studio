---
import replayData from '../data/erawan-replays.json';
interface Props { family: 'backup' | 'consolidate' | 'duplicates' }
const all = replayData.scenarios.filter(s => s.family === Astro.props.family);
const first = all[0];
const asset = '/apps/erawan/replays/';
---
<div class="erawan-replay-mount"><erawan-sim data-family={Astro.props.family}>
  <script type="application/json" set:html={JSON.stringify(all).replace(/</g, '\\u003c')} />
  <section class="replay" aria-label="Erawan terminal replay">
    <h4 class="replay-title">{first.title}</h4>
    <p class="replay-provenance">{first.capture}</p>
    <div class="replay-inputs">{first.inputs.map(input=><section><h5>📁 {input.role}</h5><code>{input.path}</code><ul>{input.files.length ? input.files.map(file=><li>{file}</li>) : <li>No files yet</li>}</ul></section>)}</div>
    <div class="replay-commands">{first.commands.map((command,i)=><section><h5>Command {i+1}</h5><pre><code>{command}</code></pre></section>)}</div>
    <p class="replay-stage" role="status" aria-live="polite">{first.frames[0].label}</p>
    <p class="replay-command-label">Current command</p><pre class="replay-active"><code>{first.frames[0].command}</code></pre>
    <button type="button" class="replay-expand" hidden>Open full terminal</button>
    <img class="replay-frame" src={asset+first.frames[0].image} alt={first.frames[0].label} loading="lazy" />
    <p class="replay-event"></p>
    <div class="replay-controls" hidden>
      <button type="button" class="replay-play">Play</button>
      <button type="button" class="replay-step">Next frame</button>
      <button type="button" class="replay-restart">Restart</button>
      <label>Frame <input type="range" min="0" max={first.frames.length-1} value="0" class="replay-seek" /></label>
      <span class="replay-position"></span>
    </div>
    <details class="replay-transcript"><summary>Transcript and recorded inputs</summary><div><pre>{first.frames.map(f=>`${f.command}\n${f.text}\n${f.event}`).join('\n\n')}</pre></div></details>
    <p class="replay-note">Recorded examples only. Playback does not operate on your files. Paths beginning /demo represent disposable fixture paths.</p>
    <dialog class="replay-dialog" aria-label="Full terminal">
      <div class="replay-dialog-controls"><button type="button" class="replay-close">Close</button><button type="button" class="replay-zoom" aria-pressed="false">Native-size zoom</button></div>
      <div class="replay-dialog-viewport"><img alt="" /></div>
    </dialog>
  </section>
  <noscript>{all.map(s=><details><summary>{s.id} · {s.title} — commands and terminal transcript</summary><pre>{s.commands.join('\n')}</pre>{s.frames.map(f=><section><h5>{f.label}</h5><img src={asset+f.image} alt={f.label} loading="lazy" style="max-width:100%;height:auto"/><pre>{f.text}</pre></section>)}</details>)}</noscript>
</erawan-sim></div>
<script>
  type Frame = { image:string; text:string; label:string; event:string; gate:boolean; command:string; duration:number };
  type Replay = { id:string; title:string; capture:string; commands:string[]; inputs:{role:string;path:string;files:string[]}[]; frames:Frame[] };
  const asset='/apps/erawan/replays/';
  class ErawanReplay extends HTMLElement {
    cleanup?:()=>void;
    connectedCallback() {
      if(this.cleanup) return;
      const all:Replay[]=JSON.parse(this.querySelector('script[type="application/json"]')!.textContent!);
      const q=<T extends HTMLElement=HTMLElement>(s:string)=>this.querySelector<T>(s)!;
      const group=this.closest('.e-situ')!;
      const reduced=matchMedia('(prefers-reduced-motion: reduce)');
      const controller=new AbortController(); const opts={signal:controller.signal};
      let current=all[0], index=0, timer:ReturnType<typeof setTimeout>|undefined, playing=false;
      const dialog=q<HTMLDialogElement>('dialog');
      const element=(tag:string,text:string)=>{const e=document.createElement(tag);e.textContent=text;return e;};
      const stop=()=>{clearTimeout(timer);timer=undefined;playing=false;};
      const render=()=>{
        const frame=current.frames[index];
        q<HTMLImageElement>('.replay-frame').src=asset+frame.image;
        q<HTMLImageElement>('.replay-frame').alt=frame.label;
        q('.replay-stage').textContent=frame.label;
        q('.replay-active code').textContent=frame.command;
        q('.replay-event').textContent=frame.event ? `Recorded input: ${frame.event}${frame.gate?' · replay paused for review':''}` : '';
        q('.replay-position').textContent=`${index+1} / ${current.frames.length}`;
        const seek=q<HTMLInputElement>('.replay-seek');seek.max=String(current.frames.length-1);seek.value=String(index);
        const play=q<HTMLButtonElement>('.replay-play');play.textContent=reduced.matches?'Step-only mode':playing?'Pause':'Play';play.disabled=reduced.matches||frame.gate||index===current.frames.length-1;
        const step=q<HTMLButtonElement>('.replay-step');step.disabled=index===current.frames.length-1;step.textContent=frame.gate&&frame.event?`Replay ${frame.event}`:'Next frame';
        const img=q<HTMLImageElement>('.replay-dialog img'); img.src=asset+frame.image;img.alt=frame.label;
      };
      const schedule=()=>{timer=setTimeout(()=>{index++;if(index>=current.frames.length-1||current.frames[index].gate)stop();render();if(playing)schedule();},current.frames[index].duration);};
      const choose=(id:string)=>{
        stop();current=all.find(s=>s.id===id)||all[0];index=0;
        q('.replay-title').textContent=current.id+' · '+current.title;q('.replay-provenance').textContent=current.capture;
        const inputs=q('.replay-inputs');inputs.replaceChildren();
        for(const input of current.inputs){const card=document.createElement('section');card.append(element('h5','📁 '+input.role),element('code',input.path));const list=document.createElement('ul');for(const file of input.files)list.append(element('li',file));if(!input.files.length)list.append(element('li','No files yet'));card.append(list);inputs.append(card);}
        const commands=q('.replay-commands');commands.replaceChildren();
        current.commands.forEach((command,i)=>{const block=document.createElement('section');block.append(element('h5',current.commands.length>1?`Terminal ${i+1}`:'Command'));const pre=document.createElement('pre');pre.append(element('code',command));const copy=element('button','Copy command') as HTMLButtonElement;copy.type='button';copy.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(command);copy.textContent='Copied';}catch{copy.textContent='Select command to copy';}});block.append(pre,copy);commands.append(block);});
        const transcript=q('.replay-transcript div');transcript.replaceChildren();
        for(const frame of current.frames){transcript.append(element('h5',frame.label),element('pre',frame.command+'\n\n'+frame.text+(frame.event?'\n\nRecorded input: '+frame.event:'')));}
        render();
      };
      q('.replay-play').addEventListener('click',()=>{if(playing){stop();render();return;}if(reduced.matches)return;playing=true;render();schedule();},opts);
      q('.replay-step').addEventListener('click',()=>{stop();index=Math.min(index+1,current.frames.length-1);render();},opts);
      q('.replay-restart').addEventListener('click',()=>choose(current.id),opts);
      q('.replay-seek').addEventListener('input',e=>{stop();index=Number((e.target as HTMLInputElement).value);render();q('.replay-event').textContent='Recorded branch · '+current.frames.slice(0,index+1).filter(f=>f.event).map(f=>f.event).join(' → ');},opts);
      group.addEventListener('change',e=>{const input=e.target as HTMLInputElement;if(input.type==='radio'&&input.id.startsWith('situ-'))choose(input.id.slice(5));},opts);
      reduced.addEventListener('change',()=>{stop();render();},opts);
      document.addEventListener('visibilitychange',()=>{if(document.hidden){stop();render();}},opts);
      q('.replay-expand').addEventListener('click',()=>{stop();render();dialog.showModal();q('.replay-close').focus();},opts);
      q('.replay-close').addEventListener('click',()=>dialog.close(),opts);
      dialog.addEventListener('close',()=>{dialog.classList.remove('zoomed');q('.replay-zoom').setAttribute('aria-pressed','false');q('.replay-expand').focus();},opts);
      q('.replay-zoom').addEventListener('click',()=>{q('.replay-zoom').setAttribute('aria-pressed',String(dialog.classList.toggle('zoomed')));},opts);
      q('.replay-controls').hidden=false;q('.replay-expand').hidden=false;
      this.closest('.e-wf')?.classList.add('e-sim-on');
      const selected=group.querySelector<HTMLInputElement>('input[type=radio]:checked');choose(selected?.id.slice(5)||all[0].id);
      this.cleanup=()=>{stop();controller.abort();if(dialog.open)dialog.close();};
    }
    disconnectedCallback(){this.cleanup?.();this.cleanup=undefined;}
  }
  if(!customElements.get('erawan-sim'))customElements.define('erawan-sim',ErawanReplay);
</script>
<style is:global>
  .erawan-replay-mount{min-width:0}
  erawan-sim{display:contents}
  .replay{min-width:0;color:var(--color-on-surface)}
  .replay h4{font-size:1.4rem;margin:1rem 0}.replay h5{font-size:1rem;margin:.5rem 0}
  .replay-provenance,.replay-note{color:var(--color-on-surface-variant);font-size:.9rem;margin:.8rem 0}
  .replay-inputs{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:1rem;margin:1rem 0}
  .replay-inputs section{border:1px solid var(--color-outline-variant);border-radius:12px;padding:1rem;overflow-wrap:anywhere}
  .replay-inputs ul{padding-left:1.2rem;margin-top:.7rem}.replay-inputs code{font-size:.9rem}
  .replay pre{white-space:pre-wrap;overflow-wrap:anywhere;background:var(--color-surface-container);padding:1rem;border-radius:8px;font:14px/1.6 monospace;margin:.5rem 0;max-width:100%}
  .replay-commands section{margin:1rem 0}.replay-stage{font-weight:700;margin:1.4rem 0 .5rem}.replay-command-label{font-size:.8rem}
  .replay-frame{display:block;width:100%;height:auto;max-width:1512px;margin:1rem auto;border-radius:8px}
  .replay button{min-height:44px;min-width:44px;padding:.6rem 1rem;border:1px solid var(--color-outline-variant);background:var(--color-surface-container-high);color:var(--color-on-surface);border-radius:7px;cursor:pointer;font:inherit}
  .replay button:disabled{opacity:.5;cursor:default}.replay :focus-visible{outline:3px solid var(--color-primary-container);outline-offset:3px}
  .replay-controls{display:flex;gap:.5rem;align-items:center;flex-wrap:wrap;margin:1rem 0}.replay-controls[hidden]{display:none}
  .replay-controls label{display:flex;align-items:center;gap:.7rem;min-width:180px;flex:1}.replay-controls input{width:100%;min-height:44px;accent-color:var(--color-primary-container)}
  .replay-event{min-height:1.5rem;font-size:.9rem}.replay summary{cursor:pointer;padding:.7rem 0;min-height:44px}
  .replay-dialog{position:fixed;inset:0;margin:auto;width:96vw;height:94dvh;max-width:none;max-height:none;background:var(--color-surface);color:var(--color-on-surface);padding:1rem;border:1px solid var(--color-outline-variant);border-radius:12px}
  .replay-dialog::backdrop{background:color-mix(in srgb,var(--color-surface) 85%,transparent)}
  .replay-dialog-controls{display:flex;gap:1rem;margin-bottom:1rem}.replay-dialog-viewport{height:calc(100% - 70px);display:flex;align-items:center;justify-content:center;overflow:auto}
  .replay-dialog img{display:block;max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain}
  .replay-dialog.zoomed .replay-dialog-viewport{display:block}.replay-dialog.zoomed img{width:1512px;max-width:none;max-height:none;height:auto}
  @media(max-width:699px){.replay-inputs{grid-template-columns:1fr}.replay-inputs section{padding:.8rem}.replay-dialog{width:100vw;height:100dvh;border-radius:0}}
</style>
