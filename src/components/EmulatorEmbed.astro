---
// The SNES C Compiler page uses the same packaged player as the galleries.
// Runtime/ROM bytes and current fidelity expectations remain in the site-owned
// manifest; the shared component owns boot, input, fullscreen and lifecycle.
import GamePlayer from '@wbniv/browser-game-player/astro';
import {verifyManifest} from '@wbniv/browser-game-player/bundle';
const {frame} = verifyManifest('public/apps/llvm-mos-65816/play/component', '/apps/llvm-mos-65816/play/component');
---

<section class="emu" aria-label="Live SNES emulator running a C-compiled Mandelbrot">
  <h2 class="section-label">Run SNES in your browser</h2>
  <div class="glass-card emu-card">
    <GamePlayer src={`${frame}?game=mandel-display`} title="Mandelbrot" />
    <p class="emu-keys"><b>← ↑ ↓ →</b> d-pad · <b>Z</b>/<b>X</b> = B/A · <b>A</b>/<b>S</b> = Y/X · <b>Enter</b> Start · <b>Shift</b> Select · <b>Q</b>/<b>W</b> = L/R</p>
  </div>
</section>

<style>
  .emu { margin: 2.5rem 0; }
  .emu-card { padding: 1rem; }
  .emu-screen {
    width: 100%;
    aspect-ratio: 8 / 7;
    background: #000;
    border-radius: var(--radius-DEFAULT, 8px);
    overflow: hidden;
    display: flex;
  }
  .emu-screen canvas {
    width: 100%;
    height: 100%;
    object-fit: contain;
    image-rendering: pixelated;
  }
  .emu-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.85rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 12px;
    color: var(--color-on-surface-variant);
  }
  .emu-btn {
    margin-left: auto;
    background: var(--color-surface-container);
    color: var(--color-on-surface);
    border: 1px solid color-mix(in srgb, var(--color-primary-container) 35%, transparent);
    border-radius: var(--radius-DEFAULT, 8px);
    padding: 0.4rem 0.85rem;
    font-size: 12px;
    cursor: pointer;
    transition: border-color 150ms ease, color 150ms ease;
  }
  .emu-btn:hover:not(:disabled) {
    border-color: var(--color-primary-container);
    color: var(--color-primary-container);
  }
  .emu-btn:disabled { opacity: 0.45; cursor: not-allowed; }
  .badge { font-family: var(--font-mono, ui-monospace, monospace); }
  .badge.running { color: var(--color-primary-container); }
  .badge.pass { background: #54d98c; color: #0c1116; font-weight: 600; padding: 2px 8px; border-radius: 5px; }
  .badge.fail { background: #ff6b6b; color: #0c1116; font-weight: 600; padding: 2px 8px; border-radius: 5px; }
  .emu-keys {
    margin: 0.75rem 0 0;
    font-size: 11.5px;
    color: var(--color-on-surface-variant);
  }
  .emu-keys b { color: var(--color-on-surface); font-weight: 600; }
  .emu-banner {
    margin: 0.6rem 0 0;
    font-size: 12px;
    color: var(--color-on-surface-variant);
  }
  .emu-banner :global(b) { color: var(--color-on-surface); }
  .emu-banner :global(code) {
    font-family: var(--font-mono, ui-monospace, monospace);
    color: var(--color-primary-fixed, var(--color-primary-container));
  }
</style>
