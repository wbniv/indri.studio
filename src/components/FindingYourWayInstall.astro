---
import PlatformIcon from './PlatformIcon.astro';
---

<section aria-labelledby="install-title" class="install-options">
  <h2 id="install-title">Install</h2>
  <div class="install-choices">
    <details class="install-choice" id="web-install">
      <summary>
        <span class="install-icons"><PlatformIcon platform="web" size={24} ariaHidden /></span>
        <span class="install-label"><strong>Web / PWA</strong><small>Play in a browser or add it to your home screen</small></span>
        <span class="install-chevron" aria-hidden="true">▸</span>
      </summary>
      <div class="install-body">
        <p>Open the <a href="#web-edition">web edition below</a>. It works offline after its first load and can be installed as an app:</p>
        <ul>
          <li><strong>Android:</strong> In Chrome, choose <strong>⋮ → Install and create shortcut → Install</strong>. Some versions show <strong>Add to Home screen</strong>.</li>
          <li><strong>iPhone / iPad:</strong> In Safari, choose <strong>Share → Add to Home Screen</strong>, then <strong>Add</strong>.</li>
          <li><strong>Computer:</strong> In Chrome or Edge, use the install button in the address bar when offered.</li>
        </ul>
      </div>
    </details>

    <details class="install-choice" id="web-3d-play" open>
      <summary>
        <span class="install-icons"><PlatformIcon platform="web" size={24} ariaHidden /><PlatformIcon platform="console" size={24} ariaHidden /></span>
        <span class="install-label"><strong>3D game in your browser</strong><small>Explore the same chapter as the Android game</small></span>
        <span class="install-chevron" aria-hidden="true">▸</span>
      </summary>
      <div class="install-body">
        <p><a class="web-play-button" href="/apps/finding-your-way/play/" data-astro-reload><span class="web-play-icon" aria-hidden="true">
          <svg class="icon-temple" data-icon="temple" viewBox="0 0 24 24"><path d="m2 8 10-6 10 6H2Zm2 3v7m5-7v7m6-7v7m5-7v7M2 21h20M3 18h18" /></svg>
          <svg class="icon-play" data-icon="play" viewBox="0 0 24 24"><path d="m8 5 11 7-11 7Z" /></svg>
          <svg class="icon-controller" data-icon="controller" viewBox="0 0 24 24"><path d="M7 7h10c3 0 4 3 5 10 .4 3-2 4-4 2l-3-3H9l-3 3c-2 2-4.4 1-4-2C3 10 4 7 7 7Z" /><path d="M6 10v5m-2.5-2.5h5M16 11h.01M19 14h.01" /></svg>
          <svg class="icon-cube" data-icon="cube" viewBox="0 0 24 24"><path d="m12 2 9 5v10l-9 5-9-5V7l9-5Zm0 10v10M3 7l9 5 9-5" /></svg>
        </span><span>Play 3D in browser</span></a></p>
        <p>Use a browser with WebGL 2. Keyboard controls are available; gamepad and phone controls are experimental. Play opens fullscreen when supported. Use the joystick or keyboard arrows; Select is at the right edge. The player opens on its own page; no installation is needed. Progress resets when you restart.</p>
      </div>
    </details>

    <details class="install-choice" id="android-install">
      <summary>
        <span class="install-icons"><PlatformIcon platform="phone" size={24} ariaHidden /><PlatformIcon platform="tablet" size={24} ariaHidden /></span>
        <span class="install-label"><strong>Android phone / tablet</strong><small>Download and open the APK on the same device</small></span>
        <span class="install-chevron" aria-hidden="true">▸</span>
      </summary>
      <div class="install-body">
        <p>The newest APK below requires Android 8.0 or later on an ARM phone or tablet. Developer options and USB debugging are not needed.</p>
        <ol>
          <li>Open this page on the device and tap the newest <a href="#android-builds-title">APK download</a>.</li>
          <li>Open the downloaded <code>.apk</code> from the browser’s downloads or the Files app.</li>
          <li>If Android blocks installation, tap <strong>Settings</strong> and enable <strong>Allow from this source</strong> for the browser or Files app. You can also find it under <strong>Settings → Apps → Special app access → Install unknown apps</strong>; names vary by device.</li>
          <li>Return to the APK, tap <strong>Install</strong>, then <strong>Open</strong>. It appears as <strong>Finding Your Way</strong>.</li>
        </ol>
        <p>You can turn off <strong>Allow from this source</strong> afterward. See <a href="https://support.google.com/pixelphone/answer/7391672?hl=en">Google’s APK installation instructions</a>.</p>
      </div>
    </details>

    <details class="install-choice" id="chromecast-install">
      <summary>
        <span class="install-icons"><PlatformIcon platform="tv" size={24} ariaHidden /></span>
        <span class="install-label"><strong>Chromecast with Google TV</strong><small>Send the APK from an Android phone</small></span>
        <span class="install-chevron" aria-hidden="true">▸</span>
      </summary>
      <div class="install-body">
        <p>Use a Chromecast with Google TV or another Android TV / Google TV device that can install apps. Connect it and your Android phone to the same Wi-Fi network. A cast-only Chromecast cannot install an APK.</p>
        <ol>
          <li>Install <a href="https://play.google.com/store/apps/details?id=com.yablio.sendfilestotv">Send files to TV</a> from Google Play on both devices. Install a TV file manager that opens APKs if needed.</li>
          <li>Download the newest <a href="#android-builds-title">APK below</a> on your phone. Open <strong>Send files to TV</strong> on the TV and choose <strong>Receive</strong>; on the phone, choose <strong>Send</strong>, select the APK in <strong>Downloads</strong>, and select your TV.</li>
          <li>Open the received APK on the TV, using the TV file manager if the transfer app cannot open it.</li>
          <li>If installation is blocked, allow the app opening the APK to <strong>Install unknown apps</strong> under <strong>Settings → Apps → Security &amp; restrictions → Unknown sources</strong> or <strong>Special app access → Install unknown apps</strong>.</li>
          <li>If that setting is unavailable, use the TV remote to select <strong>Settings → System → About → Android TV OS build</strong> seven times to enable developer mode. On other TVs, look for <strong>About → Build</strong>. Then allow the installer app and reopen the APK.</li>
          <li>Select <strong>Install</strong> and launch <strong>Finding Your Way</strong> from the TV’s apps. Play with the remote or a connected gamepad.</li>
        </ol>
        <p>This route needs no computer or debugging. You can revoke the TV installer app’s unknown-app permission afterward.</p>
      </div>
    </details>

    <div class="install-choice install-choice-soon">
      <span class="install-icons"><PlatformIcon platform="phone" size={24} ariaHidden /><PlatformIcon platform="tablet" size={24} ariaHidden /></span>
      <span class="install-label"><strong>iPhone / iPad (iOS)</strong><small>Coming soon</small></span>
    </div>
  </div>
</section>

<style>
  .install-options { margin-bottom: 34px; }
  .install-choices { border-top: 1px solid color-mix(in srgb, var(--color-primary-container) 22%, transparent); }
  .install-choice { border-bottom: 1px solid color-mix(in srgb, var(--color-primary-container) 22%, transparent); }
  .install-choice > summary {
    display: grid; grid-template-columns: 58px minmax(0, 1fr) 16px;
    align-items: center; gap: 12px; min-height: 72px; padding: 12px 0;
    list-style: none; cursor: pointer; font-family: var(--font-body);
  }
  .install-choice > summary::-webkit-details-marker { display: none; }
  .install-choice > summary::before { content: none; display: none; }
  .install-choice > summary:focus-visible { outline: 2px solid var(--color-primary-container); outline-offset: 3px; }
  .install-choice-soon { display: grid; grid-template-columns: 58px minmax(0, 1fr); align-items: center; gap: 12px; min-height: 72px; padding: 12px 0; }
  .install-icons { display: flex; gap: 4px; color: var(--color-primary-container); }
  .install-label strong { display: block; font-size: 15px; line-height: 1.35; }
  .install-label small { display: block; color: var(--color-on-surface-variant); font-size: 12px; line-height: 1.45; }
  .install-chevron { color: var(--color-primary-container); transition: transform 150ms ease; }
  .install-choice[open] .install-chevron { transform: rotate(90deg); }
  #web-3d-play[data-revealing]::details-content { transition: none; }
  .install-body { min-width: 0; padding: 0 0 18px 70px; font-size: 14px; line-height: 1.65; }
  .install-body p { margin: 0 0 12px; }
  .install-body ul, .install-body ol { padding-left: 20px; margin: 0 0 12px; }
  .install-body ul { list-style: disc; }
  .install-body ol { list-style: decimal; }
  .install-body li + li { margin-top: 9px; }
  .install-body .web-play-button { display: inline-flex; align-items: center; justify-content: center; gap: 12px; min-height: 56px; padding: 14px 24px; border: 1px solid var(--color-primary-container); border-radius: 8px; background: var(--color-primary-container); color: var(--color-on-primary-container); font-size: 17px; font-weight: 600; line-height: 1.3; text-decoration: none; max-width: 100%; }
  .web-play-icon { position: relative; width: 24px; height: 24px; flex-shrink: 0; }
  .web-play-icon svg { position: absolute; inset: 0; width: 24px; height: 24px; opacity: 0; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; animation-duration: 12s; animation-timing-function: steps(1, end); animation-iteration-count: infinite; animation-play-state: paused; }
  .install-choice[open] .web-play-icon svg { animation-play-state: running; }
  .web-play-icon .icon-temple { opacity: 1; animation-name: play-temple; }
  .web-play-icon .icon-play { fill: currentColor; stroke: none; animation-name: play-triangle; }
  .web-play-icon .icon-controller { animation-name: play-controller; }
  .web-play-icon .icon-cube { animation-name: play-cube; }
  /* Six two-second slots: play, temple, play, controller, play, cube. */
  @keyframes play-temple { 0%, 33.3333%, 100% { opacity: 0; } 16.6667% { opacity: 1; } }
  @keyframes play-triangle { 0%, 33.3333%, 66.6667%, 100% { opacity: 1; } 16.6667%, 50%, 83.3333% { opacity: 0; } }
  @keyframes play-controller { 0%, 66.6667%, 100% { opacity: 0; } 50% { opacity: 1; } }
  @keyframes play-cube { 0%, 100% { opacity: 0; } 83.3333% { opacity: 1; } }
  .web-play-button:focus-visible { outline: 3px solid var(--color-primary-container); outline-offset: 3px; }
  .web-play-button:hover { filter: brightness(1.08); }
  .install-body a { color: var(--color-primary-container); text-decoration: underline; text-underline-offset: 2px; }
  @media (max-width: 600px) {
    .install-choice > summary { gap: 8px; grid-template-columns: 54px minmax(0, 1fr) 16px; }
    .install-choice-soon { gap: 8px; grid-template-columns: 54px minmax(0, 1fr); }
    .install-body { padding-left: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .install-chevron { transition: none; }
    .web-play-icon svg { animation: none; opacity: 0; }
    .web-play-icon .icon-temple { opacity: 1; }
  }
</style>

<script>
  let activeDetails: HTMLDetailsElement | null = null;
  let cleanup = () => {};

  function revealBrowserPlay() {
    const details = document.querySelector<HTMLDetailsElement>('#web-3d-play');
    if (details === activeDetails) return;
    cleanup();
    activeDetails = details;
    const title = details?.querySelector('summary strong');
    const summary = details?.querySelector('summary');
    const body = details?.querySelector<HTMLElement>('.install-body');
    if (!details || !title || !summary || !body || !('IntersectionObserver' in window)) return;

    // Leave space below the title so the expansion is visible on screen.
    const revealSpace = 96;
    details.open = false;
    let animation: Animation | null = null;
    const finishReveal = () => {
      delete details.dataset.revealing;
      summary.removeEventListener('click', cancelReveal);
      animation = null;
    };
    const cancelReveal = () => {
      animation?.cancel();
      finishReveal();
    };
    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      stopObserving();
      const animate = !matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (animate) details.dataset.revealing = '';
      details.open = true;
      if (!animate) return;
      animation = body.animate([
        { height: '0px', opacity: 0, overflow: 'hidden' },
        { height: `${body.getBoundingClientRect().height}px`, opacity: 1, overflow: 'hidden' },
      ], { duration: 450, easing: 'ease-out' });
      summary.addEventListener('click', cancelReveal, { once: true });
      animation.finished.then(finishReveal, finishReveal);
    }, { rootMargin: `0px 0px -${revealSpace}px 0px`, threshold: 1 });
    const stopObserving = () => {
      observer.disconnect();
      summary.removeEventListener('click', stopObserving);
    };
    cleanup = () => {
      stopObserving();
      cancelReveal();
    };
    // Manual toggles take precedence over any later scroll reveal.
    summary.addEventListener('click', stopObserving, { once: true });
    observer.observe(title);
  }

  revealBrowserPlay();
  document.addEventListener('astro:page-load', revealBrowserPlay);
  document.addEventListener('astro:before-swap', () => {
    cleanup();
    activeDetails = null;
  });
</script>
