---
import { statSync, existsSync } from 'node:fs';
import loveReason from '../../public/apps/finding-your-way/milestones/2026-10-05-love-reason-v0.2/manifest.json';
import loveReasonTruth from '../../public/apps/finding-your-way/milestones/2026-10-05-love-reason-truth-v0.3/manifest.json';
import templeLove from '../../public/apps/finding-your-way/milestones/2026-10-05-temple-love-v0.1/manifest.json';

import fourRealms from '../../public/apps/finding-your-way/milestones/2026-10-06-four-realms-v0.4/manifest.json';

import endings from '../../public/apps/finding-your-way/milestones/2026-10-06-endings-v0.5/manifest.json';

// v0.5.5 publishes only the APK; release evidence is shared privately.
const visualFixes = {
  "milestone": "2026-10-06-patient-framing-v0.5.5",
  "milestoneVersion": "0.5.5",
  "chapter": "Temple / Love / Temple / Reason / Temple / Truth / Temple / God / Final Temple / Endings / Surgery",
  "apk": "parmenides-v0.5.5-12116d8b40ce9fad.apk",
  "sha256": "12116d8b40ce9fade6fc03850bbc4cc4709f8d6377dc2c6641490c1d5e418e75",
  "knownIssues": [
    "Session-local progress resets on relaunch",
    "Camera obstruction/collision postponed",
    "Provisional models and effects; full remote-driven Android routes and phone acceptance remain open",
    "Phone touch/thermal acceptance, animation, voice and journal history remain open",
    "Ending dissolution/portal closure use provisional visibility; surgery composition is corrected with provisional models",
    "Foundation rescue is provisional invisible collision support; guide departures and aether art are provisional"
  ]
};

// v0.6 also publishes only the exact archived APK.
const graphicsReview = {
  "milestone": "2026-10-07-v0.6-endings-surgery-review",
  "chapter": "Temple / Love / Temple / Reason / Temple / Truth / Temple / God / Final Temple / Endings / Surgery",
  "apk": "parmenides-v0.6-endings-surgery.1-ee82629373c95e6e.apk",
  "sha256": "ee82629373c95e6e2a1e733a7e647bc52a4a653111d78172b2fffc802b6f8c6f",
  "milestoneVersion": "0.6",
  "knownIssues": [
    "Progress resets on relaunch.",
    "Low Chromecast frame rate remains a known limitation; performance optimization is planned for v0.8.",
    "Camera obstruction/collision remains postponed; distant God scenery can appear when turning in the Being scene.",
    "The combined triangle motif can clip at close first-person approaches; the centre surgeon’s lower gloves partly enter the bottom edge.",
    "Polish is planned for v0.7; author feedback and final all-realm acceptance remain pending."
  ]
};

// v0.7 publishes only the verified archived APK.
const polishReview = {
  "milestone": "2026-10-07-v0.7-polish-review",
  "chapter": "Temple / Love / Temple / Reason / Temple / Truth / Temple / God / Final Temple / Endings / Surgery",
  "apk": "parmenides-v0.7-polish.2-ac1f33f51ff46a73.apk",
  "sha256": "ac1f33f51ff46a73889c65bf287cc16d4a39575e23643f478c23d0748dfe3a4a",
  "milestoneVersion": "0.7",
  "knownIssues": [
    "Progress resets on relaunch; complete remote-driven Android routes remain pending.",
    "Low Chromecast frame rate remains a known limitation; optimization and sustained performance measurements are v0.8.",
    "General camera obstruction/collision remains deferred; extreme close approaches can crop the arch or partially obscure the combined triangle motif. Distant inherited scenery can remain visible outside Being.",
    "Author feedback from Max remains pending. The review movie uses scripted scene fixtures rather than a continuous Android playthrough."
  ]
};

// v0.8 publishes only the exact verified release APK.
const optimizationReview = {
  "milestone": "2026-10-09-v0.8-optimization",
  "chapter": "Temple / Love / Temple / Reason / Temple / Truth / Temple / God / Final Temple / Endings / Surgery",
  "apk": "parmenides-v0.8-1ee7d292dfb793b0.apk",
  "sha256": "1ee7d292dfb793b05087bd89485a8c7b730b5fe0c9cec213ebe20eeb0078dfe5",
  "milestoneVersion": "0.8",
  "knownIssues": [
    "Progress resets on relaunch; complete phone/tablet touch acceptance remains pending.",
    "Performance is improved, but sustained 60 FPS throughout the complete chapter is not established. Current-room-only rendering remains a separate acceptance step.",
    "General camera obstruction/collision remains deferred; extreme close approaches can crop or obscure scenery.",
    "Max’s font/sign approval, normal TV-seat readability review and longer lifecycle/memory measurements remain pending."
  ]
};

const milestones = [
  {
    title: 'Optimization v0.8',
    manifest: optimizationReview,
    description: 'Reduces rendering work with retained static mesh buffers and a dedicated opaque-material shader. Adds crisp Atkinson dialogue and NPC signs, a larger near-full-screen reader, and smaller texture allocations. Preserves the complete journey, choices, histories, endings, reduced motion and Both-to-surgery coda.',
    provenance: 'Release 0.8 (Android code 93), with ZIP-compressed level data for a smaller download. The native libraries and game assets match the verified merged candidate: 7,709 story/control assertions and 554 reader checks passed. The exact release APK passed install, remote input and Home/resume on both Chromecasts. Requires Android 8.0 or later on an ARM device.',
  },
  {
    title: 'Polish v0.7',
    manifest: polishReview,
    description: 'Combines the A–F artwork passes. Refines complete surgeon glove framing, lowers and scales the canonical combined triangle motif, and isolates Being from inherited background scenery. Keeps dialogue readable through camera collisions with a guarded modal camera cut. Retains original dialogue, choices, histories, endings, reduced motion and the exclusive Both-to-surgery coda.',
    provenance: 'Iteration F review build (0.7-polish.2), frozen from source checkpoint d47d821. Passed 5,690 native assertions covering all 208 source cards and 66 ending edges, 420 rendered dialogue views, and ten Chromecast scene tours. Production input/Home-resume and the exact archived APK with launcher artwork were verified on Chromecast1.',
  },
  {
    title: 'Artwork v0.6',
    manifest: graphicsReview,
    description: 'Includes the A–E artwork passes across Temple, Love, Reason, Truth, God, the ending scenes and surgery. Adds the Being release, combined triangle motif, NonBeing portal closure and visage, and masked surgeons with surgical lighting and instruments. Ending effects pause while reading; reduced motion uses quiet states.',
    provenance: 'Iteration E review build (0.6-endings-surgery.1), preserved unchanged from source checkpoint b90655a. Passed 1,960 native checks and four Chromecast rendering tours; the exact archived APK and launcher artwork were verified on Chromecast1.',
  },
  {
    title: 'Visual fixes v0.5.5',
    manifest: visualFixes,
    description: 'Keeps the complete ending routes from v0.5. Fits dialogue text and controls, hides world geometry during dialogue, corrects sphere and arch winding, and waits for the reading camera before showing or advancing text. Corrects patient framing so the three surgeons’ faces, hands and an off-center lamp fit the upward view. Camera obstruction/collision remains postponed.',
    provenance: 'Patient-framing native regression and desktop/Chromecast checks passed against the retained complete visual baseline. Complete remote-driven Android routes and phone/tablet touch acceptance remain open.',
  },
  {
    title: 'Endings v0.5',
    manifest: endings,
    description: 'Adds separate Being, BOTH and NonBeing ending scenes, with the patient-view surgery coda on the BOTH route. Complete source accounts and final-Temple review are included; text clipping and occlusion fixes are deferred to v0.5.5.',
    provenance: 'Preserved from chapter checkpoint a636379, with matching native audits and Chromecast 1 review. Uses the previously verified atlas-fix runtime.',
  },
  {
    title: 'Four realms v0.4',
    manifest: fourRealms,
    description: 'Adds God’s guides, poster/icon inspections, hill traversal, both counsels and sixteen final Temple histories. Includes the native texture-atlas fix; ending scenes remain previews.',
    provenance: 'Preserved from chapter checkpoint 4c8c488 and engine checkpoint 1aecfbe, with native audits and completed Chromecast 1 verification.',
  },
  {
    title: 'Love/Reason/Truth v0.3',
    manifest: loveReasonTruth,
    description: 'Adds Truth’s courtroom, testimony, exhibits, both commitments and eight Temple return histories.',
    provenance: 'Preserved from source checkpoint 20c4820, with native audits and completed Chromecast 1 verification.',
  },
  {
    title: 'Love/Reason v0.2',
    manifest: loveReason,
    description: 'Adds Reason encounters and four Temple return histories, plus Love feedback fixes.',
    provenance: 'The documented 0.2-love-reason build, preserved with its original receipt and a source/Blender snapshot.',
  },
  {
    title: 'Temple/Love v0.1',
    manifest: templeLove,
    description: 'The first playable Temple/Love chapter and its changed Temple return.',
    provenance: 'The exact installed APK played by Will, preserved with its original build records.',
  },
].sort((a, b) => b.manifest.milestoneVersion.localeCompare(a.manifest.milestoneVersion, undefined, { numeric: true })).map((milestone) => {
  const base = `/apps/finding-your-way/milestones/${milestone.manifest.milestone}`;
  const apk = `${base}/${milestone.manifest.apk}`;
  const bytes = statSync(`public${apk}`).size;
  return { ...milestone, archiveRecords: existsSync(`public${base}/manifest.json`), base, apk, date: milestone.manifest.milestone.slice(0, 10), testEvidence: 'testEvidence' in milestone.manifest ? milestone.manifest.testEvidence : null, signature: existsSync(`public${base}/signature-verification.txt`), size: `${(bytes / 1024 / 1024).toFixed(1)} MiB` };
});
---

<section aria-labelledby="native-milestones-title" class="milestones">
  <h2 id="native-milestones-title">Android builds</h2>
  <p>Newest first. Download an APK or expand a row for build details.</p>

  <div class="milestone-timeline">
  {milestones.map(({ title, manifest, description, provenance, base, apk, size, date, testEvidence, signature, archiveRecords }) => (
    <details class="milestone">
      <summary>
        <span class="milestone-label">
          <strong>{title}</strong>
          <time datetime={date}>{date}</time>
        </span>
        <a class="milestone-download" href={apk} download={manifest.apk} aria-label={`Download ${title} Android APK (${size})`}>
          APK ↓ <small>{size}</small>
        </a>
      </summary>
      <div class="milestone-body">
        <p><strong>{manifest.chapter}</strong></p>
        <p>{description} {provenance}</p>
        <p>Play on an Android phone or tablet, or use a TV remote or gamepad on Google TV. Progress resets on relaunch.</p>
        <p><strong>Known issues</strong></p>
        <ul>{manifest.knownIssues.map((issue) => <li>{issue}</li>)}</ul>
        <p>APK SHA-256:</p>
        <pre><code>{manifest.sha256}</code></pre>
        {archiveRecords && <ul>
          <li><a href={`${base}/SHA256SUMS`}>SHA256SUMS</a></li>
          <li><a href={`${base}/manifest.json`}>Milestone manifest</a></li>
          <li><a href={`${base}/build-receipt.json`}>Build receipt</a></li>
          <li><a href={`${base}/${manifest.sourceSnapshot}`} download>Source and Blender snapshot</a></li>
          {testEvidence && <li><a href={`${base}/${testEvidence}`} download>Verification evidence</a></li>}
          {signature && <li><a href={`${base}/signature-verification.txt`}>Android signature verification</a></li>}
        </ul>}
      </div>
    </details>
  ))}
  </div>

  <p class="milestone-next">Artwork passes A–F and polish are available in v0.7. Performance optimization is v0.8. Max’s feedback remains pending.</p>
</section>

<style>
  .milestone-timeline { padding-left: 4px; }
  .milestone::before {
    content: ''; position: absolute; left: -24px; top: 22px;
    box-sizing: border-box; width: 9px; height: 9px; border: 2px solid var(--color-primary-container);
    border-radius: 50%; background: var(--color-surface); z-index: 1;
  }
  .milestone:not(:last-child)::after {
    content: ''; position: absolute; left: -20px; top: 27px; bottom: -27px;
    width: 1px; background: var(--color-secondary);
  }
  .milestone:last-child::before { background: var(--color-primary-container); }
  .milestone {
    position: relative;
    margin: 0 0 0 20px;
    min-width: 0;
    border-bottom: 1px solid var(--color-outline-variant);
  }
  .milestone:first-of-type { border-top: 1px solid var(--color-outline-variant); }
  summary {
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    min-height: 52px;
    list-style: none;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 15px;
  }
  summary::-webkit-details-marker { display: none; }
  summary::before { content: '▸'; color: var(--color-primary-container); }
  details[open] summary::before { content: '▾'; }
  summary:focus-visible {
    outline: 2px solid var(--color-primary-container);
    outline-offset: 3px;
  }
  .milestone-label { display: flex; align-items: baseline; gap: 14px; }
  .milestone-label strong { font-size: 15px; }
  time { font-size: 12px; color: var(--color-secondary); white-space: nowrap; }
  .milestone-download { white-space: nowrap; font-size: 14px; }
  .milestone-download small { font-size: 12px; color: var(--color-secondary); }
  .milestone-body { padding: 12px 0 8px 26px; min-width: 0; }
  .milestone:not([open]) .milestone-body { display: none; }
  .milestone-next { margin-top: 22px; }
  @media (max-width: 600px) {
    .milestone-label { display: block; }
    .milestone-label strong, time { display: block; }
    .milestone-label strong { font-size: 14px; }
    time { font-size: 11px; line-height: 1.5; }
    summary { gap: 8px; padding: 9px 0; }
    .milestone-download { font-size: 13px; }
    .milestone-download small { display: block; font-size: 11px; line-height: 1.5; }
    .milestone-body { padding-left: 22px; }
  }
</style>
