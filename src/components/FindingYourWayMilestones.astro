---
import { Image } from 'astro:assets';
import { statSync, existsSync } from 'node:fs';
import worldFoundryLogo from '../assets/screenshots/world-foundry/logo.png';
import templeGoddessScreenshot from '../assets/screenshots/finding-your-way/temple-goddess-v0.9.jpg';
import loveStreetScreenshot from '../assets/screenshots/finding-your-way/love-street-v0.9.1.png';
import truthCourtScreenshot from '../assets/screenshots/finding-your-way/truth-court-v0.9.2.png';
import godAscentScreenshot from '../assets/screenshots/finding-your-way/god-ascent-v0.9.3.png';
import v010GodSummitScreenshot from '../assets/screenshots/finding-your-way/god-summit-v0.10.png';
import v011TempleScreenshot from '../assets/screenshots/finding-your-way/temple-fire-v0.11.png';
import v08FpsScreenshot from '../assets/screenshots/finding-your-way/v0.8-fps-improvement.png';
import v081TempleScreenshot from '../assets/screenshots/finding-your-way/temple-v0.8-family.jpg';
import v07BothScreenshot from '../assets/screenshots/finding-your-way/both-v0.7.png';
import v06SurgeryScreenshot from '../assets/screenshots/finding-your-way/surgery-v0.6.png';
import v055SurgeryScreenshot from '../assets/screenshots/finding-your-way/surgery-v0.5.5.png';
// These five scenes use the level data extracted from each archived release APK,
// rendered with the desktop engine at the relevant realm fixture without overlays.
import v05NotBeingScreenshot from '../assets/screenshots/finding-your-way/notbeing-ending-v0.5.png';
import v04GodScreenshot from '../assets/screenshots/finding-your-way/god-ascent-v0.4.png';
import v03TruthScreenshot from '../assets/screenshots/finding-your-way/truth-court-v0.3.png';
import v02ReasonScreenshot from '../assets/screenshots/finding-your-way/reason-grove-v0.2.png';
import v01LoveScreenshot from '../assets/screenshots/finding-your-way/love-street-v0.1.png';
import loveReason from '../../public/apps/finding-your-way/milestones/2026-10-05-love-reason-v0.2/manifest.json';
import loveReasonTruth from '../../public/apps/finding-your-way/milestones/2026-10-05-love-reason-truth-v0.3/manifest.json';
import templeLove from '../../public/apps/finding-your-way/milestones/2026-10-05-temple-love-v0.1/manifest.json';

import fourRealms from '../../public/apps/finding-your-way/milestones/2026-10-06-four-realms-v0.4/manifest.json';

import endings from '../../public/apps/finding-your-way/milestones/2026-10-06-endings-v0.5/manifest.json';

// v0.5.5 publishes only the APK; release evidence is shared privately.
const visualFixes = {
  "milestone": "2026-10-06-patient-framing-v0.5.5",
  "milestoneVersion": "0.5.5",
  "apk": "parmenides-v0.5.5-12116d8b40ce9fad.apk",
  "sha256": "12116d8b40ce9fade6fc03850bbc4cc4709f8d6377dc2c6641490c1d5e418e75",
  "knownIssues": [
    "Camera obstruction/collision postponed",
    "Provisional models and effects; full remote-driven Android routes and phone acceptance remain open",
    "Phone touch/thermal acceptance, animation, voice and journal history remain open",
    "Ending dissolution/portal closure use provisional visibility; surgery composition is corrected with provisional models",
    "Foundation rescue is provisional invisible collision support; guide departures and aether art are provisional"
  ]
};

// v0.6 also publishes only the exact archived APK.
const graphicsReview = {
  "milestone": "2026-10-07-v0.6-endings-surgery-review",
  "apk": "parmenides-v0.6-endings-surgery.1-ee82629373c95e6e.apk",
  "sha256": "ee82629373c95e6e2a1e733a7e647bc52a4a653111d78172b2fffc802b6f8c6f",
  "milestoneVersion": "0.6",
  "knownIssues": [
    "Low Chromecast frame rate remains a known limitation; performance optimization is planned for v0.8.",
    "Camera obstruction/collision remains postponed; distant God scenery can appear when turning in the Being scene.",
    "The combined triangle motif can clip at close first-person approaches; the centre surgeon’s lower gloves partly enter the bottom edge.",
    "Polish is planned for v0.7; author feedback and final all-realm acceptance remain pending."
  ]
};

// v0.7 publishes only the verified archived APK.
const polishReview = {
  "milestone": "2026-10-07-v0.7-polish-review",
  "apk": "parmenides-v0.7-polish.2-ac1f33f51ff46a73.apk",
  "sha256": "ac1f33f51ff46a73889c65bf287cc16d4a39575e23643f478c23d0748dfe3a4a",
  "milestoneVersion": "0.7",
  "knownIssues": [
    "Complete remote-driven Android routes remain pending.",
    "Low Chromecast frame rate remains a known limitation; optimization and sustained performance measurements are v0.8.",
    "General camera obstruction/collision remains deferred; extreme close approaches can crop the arch or partially obscure the combined triangle motif. Distant inherited scenery can remain visible outside Being.",
    "Author feedback from Max remains pending. The review movie uses scripted scene fixtures rather than a continuous Android playthrough."
  ]
};

// v0.8 publishes only the exact verified release APK.
const optimizationReview = {
  "milestone": "2026-10-09-v0.8-optimization",
  "apk": "parmenides-v0.8-1ee7d292dfb793b0.apk",
  "sha256": "1ee7d292dfb793b05087bd89485a8c7b730b5fe0c9cec213ebe20eeb0078dfe5",
  "milestoneVersion": "0.8",
  "knownIssues": [
    "Performance is improved; frame rates can vary by device and scene.",
    "General camera obstruction/collision remains deferred; extreme close approaches can crop or obscure scenery.",
  ]
};

// v0.8.1 adds a native alignment hotfix while retaining the original v0.8.
const alignmentHotfix = {
  ...optimizationReview,
  knownIssues: [],
  milestone: '2026-10-10-v0.8.1-16kb',
  milestoneVersion: '0.8.1',
  apk: 'parmenides-v0.8.1-8525f4910fc01414.apk',
  sha256: '8525f4910fc01414d14e96c2d7036421bd578724c1a491e6f2a7962afc6b2078',
};

// v0.9 publishes the verified Temple and Goddess artwork release APK.
const templeGoddessRelease = {
  milestone: '2026-10-14-v0.9-temple-goddess',
  milestoneVersion: '0.9',
  apk: 'parmenides-v0.9-3ef29dc87d55934a.apk',
  sha256: '3ef29dc87d55934a98d844e489f701c4d0c0893537ba6a5bd567ea609ddfb25b',
  knownIssues: [],
};

// v0.9.1 adds the Love street artwork to the existing Temple and Goddess art.
const loveStreetRelease = {
  milestone: '2026-10-14-v0.9.1-love-street',
  milestoneVersion: '0.9.1',
  apk: 'parmenides-v0.9.1-c3ad1ffac1cc5ffe.apk',
  sha256: 'c3ad1ffac1cc5ffe0f52873549aaa35d00ef4d4400518abdfccf098069baec54',
  knownIssues: [],
};

const reasonTruthRelease = {
  milestone: '2026-10-14-v0.9.2-reason-truth',
  milestoneVersion: '0.9.2',
  apk: 'parmenides-v0.9.2-f704f5a2648cbb8e.apk',
  sha256: 'f704f5a2648cbb8e8c8f604b0d7ce9292e2b0dfb28e8066d7a2a9668f4b6bde0',
  knownIssues: [],
};

const godEndingsRelease = {
  milestone: '2026-10-14-v0.9.3-god-endings',
  milestoneVersion: '0.9.3',
  apk: 'parmenides-v0.9.3-5a3f879c1a0be268.apk',
  sha256: '5a3f879c1a0be268709e213305c0bcc5569e2caf90b00ba06004be601806a72a',
  knownIssues: [],
};

// v0.10 promotes the exact RC4 gameplay payload with release Android metadata.
const currentRoomRelease = {
  milestone: '2026-10-22-v0.10-rc4-promotion',
  milestoneVersion: '0.10',
  apk: 'parmenides-v0.10-48b88f03ae26bc9a.apk',
  sha256: '48b88f03ae26bc9a6ce5212f9dd5624587c4d72f59d91db124b22d558c2c3527',
  knownIssues: [],
};

// v0.11 promotes the exact RC1 gameplay payload with release Android metadata.
const motionLightRelease = {
  milestone: '2026-10-31-v0.11-rc1-promotion',
  milestoneVersion: '0.11',
  apk: 'parmenides-v0.11-b984f5ec395c618e.apk',
  sha256: 'b984f5ec395c618e9d12036f7575c77aa66fe0cf698b5e8cb3a574663a3e376f',
  knownIssues: [],
};

const milestones = [
  {
    title: 'Motion and light v0.11',
    manifest: motionLightRelease,
    description: 'Brings fire, coloured light and gentle movement to the chapter.',
    highlights: [
      'The Temple braziers have reshaped bowls and stands, and burn with a rising, flickering fire.',
      'Once the stained glass appears in the Temple, coloured light streams through four of its windows.',
      'The goddess floats, banners sway, portal rings turn and speakers turn toward you. Skies and the distant God peak shift as you move. Reduced motion keeps these still.',
      'Temple window frames, column bases and cornices fit cleanly. Walking off a floor in the Temple, Love, Reason or Truth returns you to that area’s entrance.',
      'Static scenery uses a smaller vertex format that needs less graphics memory, and 32-bit Android devices check what is visible faster.',
    ],
    screenshot: { src: v011TempleScreenshot, alt: 'The goddess in v0.11 between the two Temple braziers, each burning with a rising orange fire' },
  },
  {
    title: 'Chapter refinements v0.10',
    manifest: currentRoomRelease,
    description: 'A broader update to the forests, Temple architecture and 3D rendering.',
    highlights: [
      'The God ascent and Reason grove have fuller 3D trees that can face different directions each time you start.',
      'Dark patches on the Temple floor are gone. Portal panels follow their arch curves, the goddess stairs have clean sides, and the three final doors no longer have rectangular pieces above them.',
      'The game draws the area you are visiting, keeping distant scenery out of view and reducing work each frame.',
      'The game reuses matching 3D models, skips hidden arch surfaces and draws ordinary painted surfaces more efficiently.',
    ],
    screenshot: { src: v010GodSummitScreenshot, alt: 'The God summit in v0.10 with the path, trees and final doorways' },
  },
  {
    title: 'God and endings artwork v0.9.3',
    manifest: godEndingsRelease,
    description: 'Adds a painted forest ascent, a bright Being hall, a split Both passage, NotBeing fragments and a tiled surgery room.',
    screenshot: { src: godAscentScreenshot, alt: 'The painted stone path, forest and mountain horizon on the God ascent' },
  },
  {
    title: 'Reason and Truth artwork v0.9.2',
    manifest: reasonTruthRelease,
    description: 'Adds a pale tiled horizon and fuller grove in Reason, plus wood flooring, paneling, windows and a ceiling in Truth.',
    screenshot: { src: truthCourtScreenshot, alt: 'The timber courtroom in Truth, with its wood floor, windows and ceiling' },
  },
  {
    title: 'Love street artwork v0.9.1',
    manifest: loveStreetRelease,
    description: 'Adds warm paving, balcony plants, shutters, lanterns and a distant daytime street to Love.',
    screenshot: { src: loveStreetScreenshot, alt: 'The Love street in v0.9.1, with warm paving, balcony plants and lanterns' },
  },
  {
    title: 'Temple and Goddess artwork v0.9',
    manifest: templeGoddessRelease,
    description: 'Adds a new Temple shrine, banners, piers, braziers, sky and Goddess artwork.',
    screenshot: { src: templeGoddessScreenshot, alt: 'The Temple in v0.9, with its new shrine, banners, braziers and Goddess artwork' },
  },
  {
    title: '16 KB compatibility v0.8.1',
    manifest: alignmentHotfix,
    description: 'Aligns native libraries for Android devices with 16 KB memory pages.',
    // v0.8.1 retains the v0.8 game assets; this clean v0.8 preview shows the
    // shared Temple scene while the native alignment change is invisible.
    screenshot: { src: v081TempleScreenshot, alt: 'The Temple scene shared by v0.8 and the v0.8.1 compatibility release' },
  },
  {
    title: 'Optimization v0.8',
    manifest: optimizationReview,
    description: 'Improves rendering performance and adds clearer dialogue, character signs and a larger reader.',
    // Matched Chromecast HD, all-active world-heavy windows: 29.97 FPS before
    // versus 59.94, 54.73 and 57.94 after on g2, g3 and g4. Source:
    // finding-your-way/docs/diagnostics/parmenides/current-baseline-2026-10-09/
    // opaque-material-production/comparison.md (integrated v0.8 shader).
    screenshot: { src: v08FpsScreenshot, alt: 'Chromecast HD benchmark: three world-scene tours improved from about 30 FPS to 55–60 FPS with the v0.8 shader optimization' },
  },
  {
    title: 'Polish v0.7',
    manifest: polishReview,
    description: 'Refines surgeon framing, the combined triangle motif, Being’s background and camera behavior during dialogue.',
    screenshot: { src: v07BothScreenshot, alt: 'The combined triangle motif beneath the arch in the v0.7 Both passage' },
  },
  {
    title: 'Artwork v0.6',
    manifest: graphicsReview,
    description: 'Adds ending effects, the combined triangle motif, masked surgeons and broader artwork throughout the chapter.',
    screenshot: { src: v06SurgeryScreenshot, alt: 'Three masked surgeons seen from the patient’s view in v0.6' },
  },
  {
    title: 'Visual fixes v0.5.5',
    manifest: visualFixes,
    description: 'Fixes dialogue layout, sphere and arch winding, and patient-view surgery framing.',
    screenshot: { src: v055SurgeryScreenshot, alt: 'The corrected patient view of three surgeons in v0.5.5' },
  },
  {
    title: 'Endings v0.5',
    manifest: endings,
    description: 'Adds Being, Both and NonBeing ending scenes, with surgery after the Both route.',
    screenshot: { src: v05NotBeingScreenshot, alt: 'The new NonBeing ending chamber in v0.5, with a pale floating face against dark walls' },
  },
  {
    title: 'Four realms v0.4',
    manifest: fourRealms,
    description: 'Adds God’s guides, poster and icon inspections, hill traversal, both counsels and sixteen final Temple histories.',
    screenshot: { src: v04GodScreenshot, alt: 'The new God ascent in v0.4, with the Young Man, model poster, forest and mountain' },
  },
  {
    title: 'Love/Reason/Truth v0.3',
    manifest: loveReasonTruth,
    description: 'Adds Truth’s courtroom, testimony, exhibits, both commitments and eight Temple return histories.',
    screenshot: { src: v03TruthScreenshot, alt: 'The new Truth courtroom in v0.3, with exhibit stands, counsel doors and presentation desk' },
  },
  {
    title: 'Love/Reason v0.2',
    manifest: loveReason,
    description: 'Adds Reason encounters and four Temple return histories, plus Love feedback fixes.',
    screenshot: { src: v02ReasonScreenshot, alt: 'The new Reason grove in v0.2, with the White-Clad Self, weather apparatus and two choices' },
  },
  {
    title: 'Temple/Love v0.1',
    manifest: templeLove,
    description: 'Adds the first playable Temple and Love chapter and its changed Temple return.',
    screenshot: { src: v01LoveScreenshot, alt: 'The original Love street in v0.1, with First Love, the Starlet and an advice column' },
  },
].sort((a, b) => b.manifest.milestoneVersion.localeCompare(a.manifest.milestoneVersion, undefined, { numeric: true })).map((milestone) => {
  const base = `/apps/finding-your-way/milestones/${milestone.manifest.milestone}`;
  const apk = `${base}/${milestone.manifest.apk}`;
  const bytes = statSync(`public${apk}`).size;
  const knownIssues = milestone.manifest.knownIssues.filter((issue) => !/^(?:Session-local )?progress resets on relaunch\.?$/i.test(issue));
  return { ...milestone, knownIssues, archiveRecords: existsSync(`public${base}/manifest.json`), base, apk, date: milestone.manifest.milestone.slice(0, 10), testEvidence: 'testEvidence' in milestone.manifest ? milestone.manifest.testEvidence : null, size: `${(bytes / 1024 / 1024).toFixed(1)} MiB` };
});
---

<section aria-labelledby="android-builds-title" class="milestones">
  <h2 id="android-builds-title">Android builds</h2>
  <p>Newest first. Download an APK or expand a row to see what changed.</p>

  <div class="milestone-timeline">
  {milestones.map(({ title, manifest, description, highlights, screenshot, base, apk, size, date, testEvidence, archiveRecords, knownIssues }, index) => (
    <details class="milestone" id={index === 0 ? 'latest-android-release' : undefined} open={index === 0}>
      <summary>
        <span class="milestone-label">
          <strong>{title}</strong>
          <time datetime={date}>{date}</time>
        </span>
        <a class="milestone-download" href={apk} download={manifest.apk} aria-label={`Download ${title} Android APK (${size})`}>
          <span>APK ↓</span><small>{size}</small>
        </a>
      </summary>
      <div class="milestone-body">
        {screenshot && <Image src={screenshot.src} alt={screenshot.alt} width={224} height={126} loading="lazy" class="milestone-screenshot" />}
        <p>{description}</p>
        {highlights && <ul class="milestone-highlights">{highlights.map((highlight) => <li>{highlight}</li>)}</ul>}
        {knownIssues.length > 0 && <>
          <p><strong>Known issues</strong></p>
          <ul>{knownIssues.map((issue) => <li>{issue}</li>)}</ul>
        </>}
        <p class="milestone-checksum"><span>APK SHA-256:</span><code>{manifest.sha256}</code></p>
        {archiveRecords && testEvidence && <ul>
          <li><a href={`${base}/${testEvidence}`} download>Verification evidence</a></li>
        </ul>}
      </div>
    </details>
  ))}
  </div>

  <div class="catalogue-and-credit">
    <a class="world-foundry-credit" href="/apps/world-foundry-v2/">
      <Image src={worldFoundryLogo} alt="World Foundry logo" width={108} height={133} loading="lazy" />
    </a>
    <a class="art-catalogue-download" href="/apps/finding-your-way/finding-your-way_art-catalogue.pdf" download aria-label="Download the Finding Your Way art catalogue PDF">
      <span class="art-catalogue-previews">
        <img src="/apps/finding-your-way/art-catalogue-characters.png" alt="Player and goddess character views" width="600" height="464" loading="lazy" />
        <img src="/apps/finding-your-way/art-catalogue-objects.png" alt="First page of the object catalogue" width="600" height="464" loading="lazy" />
      </span>
      <strong>Download art catalogue ↓</strong>
      <span class="art-catalogue-details">PDF · 13 pages · 4.6 MB</span>
    </a>
  </div>

</section>

<style>
  .catalogue-and-credit { display: flex; align-items: stretch; justify-content: center; gap: 32px; margin-top: 36px; }
  .world-foundry-credit { display: block; position: relative; width: 120px; margin: 0; flex: none; }
  .art-catalogue-download { display: block; box-sizing: border-box; width: 283px; flex: none; padding-left: 32px; border-left: 1px solid var(--color-on-surface-variant); text-decoration: none; }
  .art-catalogue-previews { display: flex; gap: 10px; margin-bottom: 10px; }
  .art-catalogue-previews img { display: block; width: 120px; height: auto; margin: 0; border: 1px solid var(--color-on-surface-variant); border-radius: 4px; box-shadow: 0 3px 10px #0003; }
  .art-catalogue-download strong { display: block; font-size: 15px; line-height: 1.5; color: var(--color-primary-container); }
  .art-catalogue-details { display: block; margin-top: 4px; font-size: 12px; line-height: 1.5; color: var(--color-on-surface-variant); }
  .art-catalogue-download:focus-visible { outline: 2px solid var(--color-primary-container); outline-offset: 6px; }
  @media (max-width: 520px) {
    .catalogue-and-credit { flex-direction: column; align-items: center; gap: 30px; }
    .world-foundry-credit { aspect-ratio: 108 / 133; }
    .art-catalogue-download { width: 250px; max-width: 100%; padding: 24px 0 0; border-left: 0; border-top: 1px solid var(--color-on-surface-variant); }
  }
  .world-foundry-credit img { display: block; position: absolute; top: 0; right: 0; width: auto; max-width: none; height: 100%; margin: 0; }
  .world-foundry-credit:focus-visible { outline: 2px solid var(--color-primary-container); outline-offset: 6px; }
  .milestone-timeline { padding-left: 4px; }
  .milestone::before {
    content: ''; position: absolute; left: -24px; top: 22px;
    box-sizing: border-box; width: 9px; height: 9px; border: 2px solid var(--color-primary-container);
    border-radius: 50%; background: var(--color-surface); z-index: 1;
  }
  .milestone:not(:last-child)::after {
    content: ''; position: absolute; left: -20px; top: 27px; bottom: -27px;
    width: 1px; background: var(--color-secondary);
  }
  .milestone:last-child::before { background: var(--color-primary-container); }
  .milestone {
    position: relative;
    margin: 0 0 0 20px;
    min-width: 0;
    border-bottom: 1px solid var(--color-outline-variant);
  }
  .milestone:first-of-type { border-top: 1px solid var(--color-outline-variant); }
  summary {
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    min-height: 52px;
    list-style: none;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 15px;
  }
  summary::-webkit-details-marker { display: none; }
  summary::before { content: '▸'; color: var(--color-primary-container); }
  details[open] summary::before { content: '▾'; }
  summary:focus-visible {
    outline: 2px solid var(--color-primary-container);
    outline-offset: 3px;
  }
  .milestone-label { display: flex; align-items: baseline; gap: 14px; }
  .milestone-label strong { font-size: 15px; }
  time { font-size: 12px; color: var(--color-secondary); white-space: nowrap; }
  .milestone-download { display: inline-flex; flex-direction: column; align-items: flex-end; white-space: nowrap; font-size: 14px; line-height: 1.3; }
  .milestone-download small { display: block; font-size: 11px; line-height: 1.4; color: inherit; opacity: 0.8; }
  .milestone-body { padding: 12px 0 8px 26px; min-width: 0; }
  .milestone-body::after { content: ''; display: block; clear: both; }
  .milestone-body .milestone-screenshot {
    float: right;
    display: block;
    width: min(36%, 224px);
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin: 0 0 10px 18px;
    border: 1px solid var(--color-outline-variant);
    border-radius: 6px;
  }
  .milestone-body .milestone-highlights { padding-left: 20px; margin: 0 0 14px; }
  .milestone-body .milestone-highlights li + li { margin-top: 5px; }
  .milestone-body .milestone-checksum {
    clear: both;
    overflow-wrap: anywhere;
    font-family: monospace;
    font-size: 11px;
    letter-spacing: 0;
  }
  .milestone-checksum span { margin-right: 0.5em; }
  .milestone-checksum code { font: inherit; padding: 0; border: 0; background: none; }
  .milestone:not([open]) .milestone-body { display: none; }
  @media (max-width: 600px) {
    .milestone-label { display: block; }
    .milestone-label strong, time { display: block; }
    .milestone-label strong { font-size: 14px; }
    time { font-size: 11px; line-height: 1.5; }
    summary { gap: 8px; padding: 9px 0; }
    .milestone-download { font-size: 13px; }
    .milestone-body { padding-left: 22px; }
    .milestone-body .milestone-screenshot { width: min(44%, 168px); margin-left: 12px; }
    .milestone-body .milestone-checksum { font-size: 10px; }
    .milestone-checksum span, .milestone-checksum code { display: block; }
  }
</style>

<script>
  import { revealDetailsOnScroll } from '../scripts/reveal-details';
  revealDetailsOnScroll('#latest-android-release', '.milestone-body');
</script>
