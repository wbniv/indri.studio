---
import htmlControls from '@wbniv/browser-game-player/examples/html/with-controls.html?raw';
import htmlBare from '@wbniv/browser-game-player/examples/html/bare-display.html?raw';
import astroControls from '@wbniv/browser-game-player/examples/astro/WithControls.astro?raw';
import astroBare from '@wbniv/browser-game-player/examples/astro/BareDisplay.astro?raw';
import wordpressControls from '@wbniv/browser-game-player/examples/wordpress/with-controls.html?raw';
import wordpressBare from '@wbniv/browser-game-player/examples/wordpress/bare-display.html?raw';
import claude from '@wbniv/browser-game-player/examples/agent-instructions/CLAUDE.md?raw';
import codex from '@wbniv/browser-game-player/examples/agent-instructions/AGENTS.md?raw';
import MIcon from './MIcon.astro';
import { verifyManifest } from '@wbniv/browser-game-player/bundle';

const { frame } = verifyManifest(
  'public/apps/llvm-mos-65816/play/component',
  '/apps/llvm-mos-65816/play/component',
);

const useRaycasterDemo = (source: string) =>
  source.replaceAll('mandel-display', 'raycaster').replaceAll('Mandelbrot', 'Raycaster Maze');

const examples = {
  html: { controls: useRaycasterDemo(htmlControls), bare: useRaycasterDemo(htmlBare) },
  astro: { controls: useRaycasterDemo(astroControls), bare: useRaycasterDemo(astroBare) },
  wordpress: { controls: useRaycasterDemo(wordpressControls), bare: useRaycasterDemo(wordpressBare) },
  claude: { controls: useRaycasterDemo(claude), bare: useRaycasterDemo(claude) },
  codex: { controls: useRaycasterDemo(codex), bare: useRaycasterDemo(codex) },
};
---

<section class="embed-examples" aria-labelledby="embed-examples-title">
  <div class="section-heading">
    <p class="eyebrow">Integrate the player</p>
    <h2 id="embed-examples-title">Choose your format</h2>
    <p>Copy a working example for your site or coding assistant. WordPress 5.0+ uses a Gutenberg Custom HTML block; the editing account must be allowed to save iframe markup. The HTML samples import <code>mountPlayer</code> from the shared package at <code>/player/browser-game-player/src/embed.mjs</code>; host that module and the frozen SNES bundle on your own site.</p>
  </div>
  <div class="example-layout">
    <section class="preview-card" aria-label="Live player preview">
      <div class="preview-heading"><span>Raycaster Maze · live preview</span><span id="preview-format">HTML · bare display</span></div>
      <iframe id="example-preview" title="SNES player preview" loading="lazy" allow="fullscreen; autoplay; gamepad" allowfullscreen></iframe>
    </section>
    <div class="code-card">
      <div class="code-toolbar">
        <div class="format-settings">
          <div class="format-control-row">
            <label class="format-select-label" for="example-format">Format</label>
            <select id="example-format" aria-label="Example format">
              <option value="html">HTML</option>
              <option value="astro">Astro 5–7</option>
              <option value="wordpress">WordPress 5.0+</option>
              <option value="claude">Claude Code</option>
              <option value="codex">Codex / AGENTS.md</option>
            </select>
          </div>
          <label id="mode-label" class="controls-toggle">
            <input id="example-controls" type="checkbox" />
            <span>Include controls</span>
          </label>
          <span id="example-filename" class="code-filename">bare-display.html</span>
        </div>
        <span class="copy-action">
          <span id="copy-toast" class="copy-toast" role="status" aria-live="polite"></span>
          <button type="button" id="copy-example" aria-label="Copy source"><MIcon name="content_copy" size={20} ariaHidden /></button>
        </span>
      </div>
      <pre><code id="example-source"></code></pre>
    </div>
  </div>
</section>

<script define:vars={{ examples, frame }}>
  const format = document.querySelector('#example-format');
  const controls = document.querySelector('#example-controls');
  const source = document.querySelector('#example-source');
  const filename = document.querySelector('#example-filename');
  const preview = document.querySelector('#example-preview');
  const previewFormat = document.querySelector('#preview-format');
  const copy = document.querySelector('#copy-example');
  const toast = document.querySelector('#copy-toast');
  let previewStarted = false;
  const names = { html: ['with-controls.html', 'bare-display.html'], astro: ['WithControls.astro', 'BareDisplay.astro'], wordpress: ['with-controls.html', 'bare-display.html'], claude: ['CLAUDE.md', 'CLAUDE.md'], codex: ['AGENTS.md', 'AGENTS.md'] };
  const labels = { html: 'HTML', astro: 'Astro 5–7', wordpress: 'WordPress 5.0+', claude: 'Claude Code', codex: 'Codex / AGENTS.md' };
  function previewSource() {
    const selectedMode = controls.checked ? 'controls' : 'bare';
    return `${frame}?game=raycaster${selectedMode === 'bare' ? '&display=bare' : ''}`;
  }
  function renderExample() {
    const selectedMode = controls.checked ? 'controls' : 'bare';
    source.textContent = examples[format.value][selectedMode];
    filename.textContent = names[format.value][selectedMode];
    previewFormat.textContent = `${labels[format.value]} · ${controls.checked ? 'with controls' : 'bare display'}`;
    if (previewStarted) preview.src = previewSource();
  }
  format.addEventListener('change', renderExample);
  controls.addEventListener('change', renderExample);
  copy.addEventListener('click', async () => {
    await navigator.clipboard.writeText(source.textContent);
    toast.textContent = 'Copied!';
    toast.classList.remove('visible');
    requestAnimationFrame(() => toast.classList.add('visible'));
    clearTimeout(toast.dismissTimer);
    toast.dismissTimer = setTimeout(() => toast.classList.remove('visible'), 1500);
  });
  renderExample();
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(entries => {
      if (!entries.some(entry => entry.isIntersecting && entry.intersectionRatio >= 0.2)) return;
      previewStarted = true;
      preview.src = previewSource();
      observer.disconnect();
    }, { threshold: 0.2 });
    observer.observe(document.querySelector('.preview-card'));
  } else {
    previewStarted = true;
    preview.src = previewSource();
  }
</script>

<style>
  .embed-examples { margin: 4rem 0; }
  .section-heading { margin-bottom:1.25rem; }
  .section-heading h2 { margin:.25rem 0 .5rem; font-size:clamp(1.6rem,4vw,2.2rem); color:var(--color-primary-container); }
  .section-heading p:not(.eyebrow) { max-width:38rem; margin:0; opacity:.8; }
  .eyebrow { margin:0; font-size:.75rem; text-transform:uppercase; letter-spacing:.12em; opacity:.7; }
  [hidden] { display:none !important; }
  .format-settings { display:flex; flex-direction:column; align-items:flex-start; gap:.35rem; min-width:0; }
  .format-control-row { display:flex; align-items:center; flex-wrap:wrap; gap:.65rem; }
  .format-select-label { font-size:.8rem; font-weight:650; opacity:.9; }
  select { min-width:12rem; max-width:100%; font:inherit; color:inherit; background:var(--color-surface-container-high,#38342f); border:1px solid #77736d; border-radius:.5rem; padding:.55rem .75rem; }
  .controls-toggle { display:flex; gap:.55rem; align-items:center; margin:.1rem 0 0 .1rem; font-size:.9rem; cursor:pointer; }
  .controls-toggle input { width:1.1rem; height:1.1rem; accent-color:var(--color-primary-container); }
  .copy-action { position:relative; display:inline-flex; justify-self:end; grid-row:1; grid-column:2; }
  button#copy-example { display:grid; place-items:center; width:2.4rem; height:2.4rem; padding:.4rem; color:inherit; background:var(--color-surface-container-high,#38342f); border:1px solid currentColor; border-radius:.5rem; cursor:pointer; }
  button#copy-example:hover { color:var(--color-primary-container); }
  .copy-toast { position:absolute; z-index:2; right:50%; bottom:calc(100% + .45rem); transform:translate(50%,.45rem); opacity:0; pointer-events:none; white-space:nowrap; padding:.35rem .55rem; border-radius:.4rem; background:#f2eee8; color:#181715; font-size:.78rem; font-weight:600; box-shadow:0 2px 8px #0005; transition:opacity .22s ease,transform .22s ease; }
  .copy-toast.visible { opacity:1; transform:translate(50%,0); }
  .copy-toast::after { content:""; position:absolute; top:100%; left:50%; border:.3rem solid transparent; border-top-color:#f2eee8; transform:translateX(-50%); }
  .example-layout { display:flex; flex-direction:column; gap:1rem; align-items:stretch; }
  .preview-card { width:min(100%,38rem); min-width:0; overflow:hidden; border:1px solid #77736d; border-radius:.75rem; background:#181715; }
  .preview-heading { display:flex; justify-content:space-between; gap:.6rem; padding:.6rem .75rem; border-bottom:1px solid #55514c; font-size:.8rem; }
  .preview-heading span:last-child { opacity:.7; text-align:right; }
  .preview-card iframe { display:block; width:100%; height:clamp(24rem,42vw,34rem); border:0; background:#111820; }
  .code-card { border:1px solid #77736d; border-radius:.75rem; overflow:visible; background:#181715; color:#f2eee8; }
  .code-toolbar { display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:start; gap:1rem; padding:.7rem .8rem; border-bottom:1px solid #55514c; border-radius:.75rem .75rem 0 0; background:#11100f; font-size:.85rem; }
  .code-filename { color:#bbb5ad; font-size:.74rem; }
  pre { margin:0; padding:1rem; max-height:34rem; overflow-x:hidden; overflow-y:auto; border-radius:0 0 .75rem .75rem; font-size:.82rem; line-height:1.55; tab-size:2; }
  code { white-space:pre-wrap; overflow-wrap:anywhere; }
  @media(max-width:700px) { .preview-card { width:100%; } .preview-card iframe { height:30rem; } .code-toolbar { gap:.5rem; } select { min-width:min(12rem, 100%); } }
  @media(prefers-reduced-motion:reduce) { .copy-toast { transition:none; } }
</style>
