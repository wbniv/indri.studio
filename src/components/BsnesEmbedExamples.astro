---
import htmlControls from '@wbniv/browser-game-player/examples/html/with-controls.html?raw';
import htmlBare from '@wbniv/browser-game-player/examples/html/bare-display.html?raw';
import astroControls from '@wbniv/browser-game-player/examples/astro/WithControls.astro?raw';
import astroBare from '@wbniv/browser-game-player/examples/astro/BareDisplay.astro?raw';
import wordpressControls from '@wbniv/browser-game-player/examples/wordpress/with-controls.html?raw';
import wordpressBare from '@wbniv/browser-game-player/examples/wordpress/bare-display.html?raw';
import claude from '@wbniv/browser-game-player/examples/agent-instructions/CLAUDE.md?raw';
import codex from '@wbniv/browser-game-player/examples/agent-instructions/AGENTS.md?raw';

const examples = {
  html: { controls: htmlControls, bare: htmlBare },
  astro: { controls: astroControls, bare: astroBare },
  wordpress: { controls: wordpressControls, bare: wordpressBare },
  claude: { controls: claude, bare: claude },
  codex: { controls: codex, bare: codex },
};
---

<section class="embed-examples" aria-labelledby="embed-examples-title">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Integrate the player</p>
      <h2 id="embed-examples-title">Choose your format</h2>
      <p>Copy a working example for your site or coding assistant. Examples use the shared browser player and frozen SNES bundle.</p>
    </div>
    <div class="example-selectors">
      <label>Format
        <select id="example-format" aria-label="Example format">
          <option value="html">HTML</option>
          <option value="astro">Astro</option>
          <option value="wordpress">WordPress</option>
          <option value="claude">Claude Code</option>
          <option value="codex">Codex / AGENTS.md</option>
        </select>
      </label>
      <label id="mode-label">Display
        <select id="example-mode" aria-label="Display mode">
          <option value="controls">With controls</option>
          <option value="bare">Bare display</option>
        </select>
      </label>
    </div>
  </div>
  <div class="code-card">
    <div class="code-toolbar"><span id="example-filename">with-controls.html</span><button type="button" id="copy-example">Copy source</button></div>
    <pre><code id="example-source"></code></pre>
  </div>
</section>

<script define:vars={{ examples }}>
  const format = document.querySelector('#example-format');
  const mode = document.querySelector('#example-mode');
  const modeLabel = document.querySelector('#mode-label');
  const source = document.querySelector('#example-source');
  const filename = document.querySelector('#example-filename');
  const copy = document.querySelector('#copy-example');
  const names = { html: ['with-controls.html', 'bare-display.html'], astro: ['WithControls.astro', 'BareDisplay.astro'], wordpress: ['with-controls.html', 'bare-display.html'], claude: ['CLAUDE.md', 'CLAUDE.md'], codex: ['AGENTS.md', 'AGENTS.md'] };
  function renderExample() {
    const isAgent = format.value === 'claude' || format.value === 'codex';
    modeLabel.hidden = isAgent;
    const selectedMode = isAgent ? 'controls' : mode.value;
    source.textContent = examples[format.value][selectedMode];
    filename.textContent = names[format.value][selectedMode];
    copy.textContent = 'Copy source';
  }
  format.addEventListener('change', renderExample);
  mode.addEventListener('change', renderExample);
  copy.addEventListener('click', async () => {
    await navigator.clipboard.writeText(source.textContent);
    copy.textContent = 'Copied';
    setTimeout(() => { copy.textContent = 'Copy source'; }, 1600);
  });
  renderExample();
</script>

<style>
  .embed-examples { margin: 4rem 0; }
  .section-heading { display:flex; justify-content:space-between; align-items:end; gap:2rem; margin-bottom:1.25rem; }
  .section-heading h2 { margin:.25rem 0 .5rem; font-size:clamp(1.6rem,4vw,2.2rem); color:var(--color-primary-container); }
  .section-heading p:not(.eyebrow) { max-width:38rem; margin:0; opacity:.8; }
  .eyebrow { margin:0; font-size:.75rem; text-transform:uppercase; letter-spacing:.12em; opacity:.7; }
  .example-selectors { display:flex; gap:.75rem; flex-wrap:wrap; }
  [hidden] { display:none !important; }
  label { display:grid; gap:.35rem; font-size:.75rem; opacity:.9; }
  select, button { font:inherit; color:inherit; background:var(--color-surface-container-high,#38342f); border:1px solid currentColor; border-radius:.5rem; padding:.6rem .8rem; }
  .code-card { border:1px solid #77736d; border-radius:.75rem; overflow:hidden; background:#181715; color:#f2eee8; }
  .code-toolbar { display:flex; justify-content:space-between; align-items:center; padding:.55rem .8rem; border-bottom:1px solid #55514c; font-size:.85rem; }
  .code-toolbar button { cursor:pointer; padding:.35rem .7rem; }
  pre { margin:0; padding:1rem; max-height:30rem; overflow:auto; font-size:.82rem; line-height:1.55; tab-size:2; }
  code { white-space:pre; }
  @media(max-width:700px) { .section-heading { display:block; } .example-selectors { margin-top:1rem; } .example-selectors label { flex:1; } }
</style>
