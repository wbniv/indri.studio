---
import BsnesEmbedExamples from './BsnesEmbedExamples.astro';
import BsnesSuiteChooser from './BsnesSuiteChooser.astro';
import BsnesPlayerActivity from './BsnesPlayerActivity.astro';
---

<div class="product-body">
  <section class="downloads" aria-labelledby="download-title">
    <div class="section-heading">
      <p class="eyebrow">Example integrations</p>
      <h2 id="download-title">Native Android APK examples</h2>
      <p>Two signed Native examples: the full LLVM 65816 suite app and a compact standalone Raycaster Maze player. More at <a href="https://biohack.net/snes/">biohack.net/snes</a>.</p>
    </div>
    <div class="download-grid">
      <article class="download-card suite-download-card">
        <p class="eyebrow">LLVM 65816 suite</p>
        <h3>Torture-test suite</h3>
        <p>Opens the suite chooser so you can select and run a test ROM.</p>
        <BsnesSuiteChooser />
        <dl class="suite-facts">
          <div><dt>Package</dt><dd><code>org.bsnesjg.tv.native.phase2</code></dd></div>
          <div><dt>Version</dt><dd>0.1.9</dd></div>
          <div><dt>APK size</dt><dd>25.57 MiB</dd></div>
        </dl>
        <a class="download-link" href="https://downloads.biohack.net/bsnes-jg/releases/0.1.9/bsnes-jg_llvm-65816-torture-test-suite-on-snes-v0.1.9.apk">Download suite APK <span aria-hidden="true">↓</span></a>
        <details><summary>SHA-256 · 26,814,539 bytes</summary><code class="hash">c04666f5abe7f6865b4e2cfdd695cf47c238e06a78a50a4a8e7d27e73532f88c</code></details>
      </article>
    </div>
    <p class="release-note">The <a href="https://downloads.biohack.net/bsnes-jg/current.json">release manifest</a> records current and previous versions, sizes, package IDs, and hashes. The stable download URL redirects here.</p>
  </section>

  <BsnesEmbedExamples />
  <BsnesPlayerActivity />

  <footer class="source-links">
    <a href="https://github.com/wbniv/bsnes-jg-player">Source repository <span aria-hidden="true">↗</span></a>
    <a href="https://github.com/wbniv/browser-game-player/releases/tag/v0.1.12">Player package · v0.1.12 <span aria-hidden="true">↗</span></a>
    <a href="https://biohack.net/snes/">SNES browser demos <span aria-hidden="true">↗</span></a>
  </footer>
</div>

<style>
  .product-body { width:100%; min-width:0; color:#f2eee8; }
  .eyebrow { color:#c4beb6; font-size:.72rem; font-weight:600; letter-spacing:.12em; text-transform:uppercase; }
  .downloads { margin:2.7rem 0 3.8rem; }
  .section-heading { margin-bottom:1.15rem; }
  .section-heading h2 { margin:.3rem 0 .65rem; color:var(--color-primary-container,#b8f400); font-size:clamp(1.8rem,4vw,2.8rem); line-height:1.1; }
  .section-heading p:last-child { max-width:52rem; margin:0; color:#c4beb6; font-size:.95rem; line-height:1.55; }
  .download-grid { display:grid; grid-template-columns:minmax(0,1fr); gap:1.25rem; }
  .download-card { display:flex; flex-direction:column; align-items:flex-start; min-width:0; padding:clamp(1rem,2.4vw,1.5rem); border:1px solid #514d47; border-radius:.8rem; background:#302d29; }
  .download-card .eyebrow { margin:0 0 .55rem; }
  .download-card h3 { margin:0 0 .4rem; font-size:clamp(1.25rem,2.3vw,1.7rem); }
  .download-card > p:not(.eyebrow) { max-width:38rem; margin:0 0 .85rem; color:#c4beb6; line-height:1.5; }
  dl { width:100%; margin:0 0 1rem; }
  dl div { display:grid; grid-template-columns:minmax(5.5rem,.55fr) minmax(0,1fr); gap:.8rem; padding:.45rem 0; border-bottom:1px solid #514d47; }
  dt { color:#a9a39b; font-size:.78rem; }
  dd { min-width:0; margin:0; overflow-wrap:anywhere; }
  .download-card a.download-link { display:flex; width:100%; align-items:center; justify-content:center; gap:.6rem; margin-top:auto; padding:.68rem 1rem; border:1px solid #17190e; border-radius:.45rem; background:#b8f400; color:#17190e !important; font-weight:750; text-decoration:none; text-shadow:none; }
  .download-card a.download-link:hover { background:#d4ff24; color:#11130b !important; }
  .download-card a.download-link:focus-visible { outline:3px solid #fff; outline-offset:3px; }
  details { width:100%; margin-top:1rem; color:#c4beb6; font-size:.8rem; }
  summary { cursor:pointer; }
  .hash { display:block; margin-top:.45rem; overflow-wrap:anywhere; color:#f2eee8; }
  .release-note { margin:.85rem 0 0; color:#c4beb6; font-size:.78rem; line-height:1.55; }
  a { color:inherit; text-underline-offset:.18em; }
  .source-links { display:flex; flex-wrap:wrap; gap:.75rem 1.5rem; padding:1.25rem 0 2rem; border-top:1px solid #625e58; }
  .source-links a { color:var(--color-primary-container,#b8f400); font-weight:600; }
  .suite-facts { display:grid; grid-template-columns:1fr 1fr; column-gap:1rem; }
  .suite-facts div { display:flex; flex-direction:column; gap:.15rem; min-width:0; padding:.4rem 0; border-bottom:0; }
  .suite-facts div:first-child { grid-column:1/-1; border-bottom:1px solid #514d47; }
  .suite-facts dd { font-size:.82rem; }
  .suite-facts code { font-size:.8rem; }
  @media (max-width:640px) { .download-grid { grid-template-columns:1fr; } .downloads { margin:2.5rem 0 3.2rem; } }
</style>
