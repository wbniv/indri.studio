---
import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import Base from '../../../../layouts/Base.astro';
const base = 'public/apps/finding-your-way/play';
const manifest = JSON.parse(readFileSync(`${base}/manifest.json`, 'utf8'));
if (!/^v0\.8-[a-f0-9]{16}$/.test(manifest.bundleId)) throw new Error('Invalid Finding Your Way bundle ID');
const receipt = JSON.parse(readFileSync(`${base}/bundles/${manifest.bundleId}/receipt.json`, 'utf8'));
if (manifest.bundleId !== receipt.bundleId) throw new Error('Finding Your Way receipt mismatch');
for (const [name, raw] of Object.entries(receipt.files)) {
  const info = raw as { sha256: string; bytes: number };
  if (!/^[a-zA-Z0-9_.-]+$/.test(name)) throw new Error('Invalid Finding Your Way artifact name');
  const bytes = readFileSync(`${base}/bundles/${manifest.bundleId}/${name}`);
  if (bytes.length !== info.bytes || createHash('sha256').update(bytes).digest('hex') !== info.sha256)
    throw new Error(`Finding Your Way artifact differs: ${name}`);
}
const frame = `/apps/finding-your-way/play/bundles/${manifest.bundleId}/frame.html`;
---
<Base title="Finding Your Way — Play the 3D game" description="Explore Finding Your Way in your browser. No installation needed.">
  <main class="fyw-browser-page">
    <a href="/apps/finding-your-way/" data-astro-reload>← App details and downloads</a>
    <h1>Finding Your Way</h1>
    <p>Play the 3D chapter in your browser. Choose Play below to load the game.</p>
    <iframe class="fyw-browser-frame" src={frame} title="Finding Your Way 3D player" allow="fullscreen; autoplay; gamepad" allowfullscreen></iframe>
    <p class="fyw-browser-note">WebGL 2 is required. Keyboard and gamepad controls are available. Phone controls are experimental; this browser edition does not yet save your progress.</p>
    <p><a href="/apps/finding-your-way/#android-builds-title" data-astro-reload>Android downloads</a> · <a href="/apps/finding-your-way/" data-astro-reload>Text edition and other ways to play</a></p>
  </main>
</Base>
<style>
.fyw-browser-page { max-width: 1120px; margin: 0 auto; padding: 32px 20px; }
.fyw-browser-page h1 { font-size: clamp(28px, 5vw, 48px); margin: 24px 0 12px; }
.fyw-browser-page p { line-height: 1.6; }
.fyw-browser-frame { display: block; width: 100%; height: min(850px, calc(56.25vw + 240px)); min-height: 430px; border: 1px solid #746f5e; border-radius: 8px; margin: 24px 0; background: #29261f; }
.fyw-browser-note { font-size: 0.95rem; }
@media(max-width:600px) { .fyw-browser-page { padding: 24px 12px; } }
</style>
<script>
window.addEventListener('message', (event) => {
  if (event.origin !== location.origin || event.data?.type !== 'fyw-player-height') return;
  const iframe = document.querySelector<HTMLIFrameElement>('.fyw-browser-frame');
  if (!iframe || event.source !== iframe.contentWindow) return;
  const height = event.data.height;
  if (typeof height === 'number' && Number.isFinite(height) && height >= 200 && height <= 2000)
    iframe.style.height = `${Math.ceil(height)}px`;
});
</script>
