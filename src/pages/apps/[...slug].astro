---
import AppLayout from "../../layouts/AppLayout.astro";
import WorldFoundryHero from "../../components/WorldFoundryHero.astro";
import StoreBadges from "../../components/StoreBadges.astro";
import Screenshot from "../../components/Screenshot.astro";
import MIcon from "../../components/MIcon.astro";
import FindingYourWayMilestones from "../../components/FindingYourWayMilestones.astro";
import FindingYourWayInstall from "../../components/FindingYourWayInstall.astro";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import lightboxUrl from "../../scripts/cca-lightbox.js?url";
import bgaDemoUrl from "../../scripts/bga-demo-player.js?url";

export async function getStaticPaths() {
	// Same sort as the homepage gallery — alphabetical with finding-your-way
	// pinned last — so prev/next here matches the order users see there.
	const posts = (await getCollection("apps", ({ data }) => !data.draft && !data.externalUrl)).sort((a, b) => {
		if (a.id === "finding-your-way") return 1;
		if (b.id === "finding-your-way") return -1;
		return a.data.title.localeCompare(b.data.title);
	});
	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: {
			post,
			// Wrap around at the edges so the catalogue cycles continuously.
			prev: posts[(i - 1 + posts.length) % posts.length],
			next: posts[(i + 1) % posts.length],
		},
	}));
}

interface Props {
	post: CollectionEntry<"apps">;
	prev: CollectionEntry<"apps">;
	next: CollectionEntry<"apps">;
}
const { post, prev, next } = Astro.props;
const { Content } = await render(post);

const now = new Date();
const upcoming = post.data.date.valueOf() > now.valueOf();

// Finding Your Way has a share card; other app pages use their first
// screenshot. Open Graph image URLs must be absolute for link previews.
const ogImagePath = post.id === 'finding-your-way'
	? '/apps/finding-your-way/share-card.png'
	: post.data.screenshots[0]?.src.src;
const ogImage = ogImagePath ? new URL(ogImagePath, Astro.site).href : undefined;
---

<AppLayout
	title={post.data.title}
	description={post.data.summary}
	ogImage={ogImage}
	ogType="article"
	theme={post.data.theme}
	prevHref={`/apps/${prev.id}/`}
	nextHref={`/apps/${next.id}/`}
>
	<article
		style="view-transition-name: app-content"
		class="max-w-[720px] mx-auto px-6 md:px-8 py-12 md:py-20"
	>
		<nav aria-label="Catalogue navigation" class="catalogue-nav">
			<a
				href={`/apps/${prev.id}/`}
				class="side-nav side-nav-inline group"
				aria-label={`Previous: ${prev.data.title}`}
			>
				<MIcon name="chevron_left" class="side-nav-arrow" size={28} ariaHidden />
				<span class="side-nav-label">
					<span class="side-nav-eyebrow">previous</span>
					<span class="side-nav-title">{prev.data.title}</span>
				</span>
			</a>
			<a
				href="/#apps"
				class="side-nav-inline side-nav-all-apps"
				aria-label="All apps"
			>
				<MIcon name="apps" class="side-nav-arrow" size={28} ariaHidden />
				<span class="side-nav-title">All apps</span>
			</a>
			<a
				href={`/apps/${next.id}/`}
				class="side-nav side-nav-inline group"
				aria-label={`Next: ${next.data.title}`}
			>
				<span class="side-nav-label side-nav-label-right">
					<span class="side-nav-eyebrow">next</span>
					<span class="side-nav-title">{next.data.title}</span>
				</span>
				<MIcon name="chevron_right" class="side-nav-arrow" size={28} ariaHidden />
			</a>
		</nav>

		<header class="mb-10">
			{post.id === 'world-foundry-v2' ? (
				<WorldFoundryHero title={post.data.title} summary={post.data.summary} logo={post.data.logo} upcoming={upcoming} github={post.data.storeLinks?.github} />
			) : (
			<>
			{upcoming && (
				<div class="flex flex-wrap items-center gap-3 mb-6">
					<span class="pill-purple">
						<MIcon name="rocket_launch" size={14} ariaHidden />
						Launching Soon
					</span>
				</div>
			)}

			{post.id === 'bsnes-jg-player' ? (
				<div class="bsnes-page-heading">
					<p class="bsnes-page-kicker">SNES emulator · WebAssembly</p>
					<h1 class="font-display text-headline-lg text-primary-container tracking-tighter">{post.data.title}</h1>
					<p class="bsnes-page-summary">{post.data.summary}</p>
				</div>
			) : post.id === 'finding-your-way' ? (
				<div class="flex items-center gap-3 md:gap-4 mb-6">
					{post.data.cardImages[1] && <Image src={post.data.cardImages[1].src} alt="" width={80} height={80} class="w-16 h-16 md:w-20 md:h-20 flex-none" />}
					<div class="min-w-0">
						<p class="font-display uppercase tracking-[0.15em] text-[10px] text-on-surface-variant mb-1">Web + Android adventure</p>
						<h1 class="font-display text-[28px] sm:text-headline-lg text-primary-container tracking-tighter leading-tight">{post.data.title}</h1>
					</div>
				</div>
			) : (
				<h1 class="font-display text-headline-lg text-primary-container tracking-tighter mb-6">{post.data.title}</h1>
			)}

			{post.id === 'bsnes-jg-player' ? (
				<section class="bsnes-landing" aria-label="Browser SNES player">
					<figure class="bsnes-hero-preview">
						<video class="bsnes-hero-video" autoplay muted loop playsinline preload="metadata" poster="/apps/bsnes-jg-wasm/raycaster.png" aria-label="Looping Raycaster Maze gameplay">
							<source src="/apps/bsnes-jg-wasm/raycaster-loop.mp4" type="video/mp4" />
						</video>
						<figcaption><span>Raycaster Maze · gameplay loop</span><span class="bsnes-live"><i></i>Live</span></figcaption>
					</figure>
					<div class="bsnes-npm-install">
						<p class="bsnes-install-label">Install from npm</p>
						<div class="bsnes-command-row"><code>npm i @wbniv/bsnes-jg-player</code><button type="button" data-copy-install aria-label="Copy npm install command"><MIcon name="content_copy" size={20} ariaHidden /></button><span data-copy-install-status role="status" aria-live="polite"></span></div>
					</div>
					<nav class="bsnes-hero-links" aria-label="Player links">
						<a href="#embed-examples-title">Embed player <MIcon name="code" size={18} ariaHidden /></a>
						<a href="https://github.com/wbniv/bsnes-jg-player">GitHub <MIcon name="open_in_new" size={17} ariaHidden /></a>
					</nav>
					<a class="bsnes-android-link" href="#download-title">Also available as an Android app <MIcon name="chevron_right" size={20} ariaHidden /></a>
				</section>
			) : (
				<>
					{post.data.logo && post.id !== 'finding-your-way' && (
						<Image
							src={post.data.logo}
							alt=""
							class="mb-6"
							loading="eager"
							fetchpriority="high"
						/>
					)}

					{post.data.summary && (
						<p class="font-body text-body-lg text-secondary border-l-2 border-primary-container pl-6">
							{post.data.summary}
						</p>
					)}
					<StoreBadges links={post.data.storeLinks} />
				</>
			)}
			</>
			)}
		</header>

		<div class="prose">
			<Content />
			{post.id === 'claude-code-authoring-formats' && <script src={lightboxUrl}></script>}
			{post.id === 'bga-title-tray' && <script src={bgaDemoUrl}></script>}
		</div>

		{post.id === 'finding-your-way' && (
			<div class="prose mt-12 md:mt-16">
				<FindingYourWayInstall />
				<FindingYourWayMilestones />
			</div>
		)}

		{post.data.screenshots.length > 0 && (
			<section id={post.id === 'finding-your-way' ? 'web-edition' : undefined} class:list={[post.id === 'finding-your-way' ? 'mt-10 md:mt-14' : 'mt-12 md:mt-16']}>
				<h2 class="section-label !mb-3">{post.id === 'finding-your-way' ? 'Web edition' : 'screenshots'}</h2>
				{post.id === 'finding-your-way' && (
					<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 mb-5">
						<a href="https://d2cpue9r0hnyl3.cloudfront.net/" class="font-display font-semibold text-primary-container underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-primary-container">Open the web edition ↗</a>
						<span class="text-sm text-on-surface-variant">Original hypertext · installable PWA</span>
					</div>
				)}
				<ul class:list={["list-none p-0 m-0", post.id === 'world-foundry-v2' ? 'sm:columns-2 sm:gap-x-4 md:gap-x-6' : ['grid sm:grid-cols-2', post.id === 'finding-your-way' ? 'grid-cols-2 gap-2.5 md:gap-4' : 'grid-cols-1 gap-4 md:gap-6']]}>
					{post.data.screenshots.map((shot, idx) => (
						<li class:list={["glass-card", post.id === 'finding-your-way' ? 'p-2 md:p-3' : 'p-3', post.id === 'world-foundry-v2' && 'break-inside-avoid mb-4 md:mb-6']}>
							{post.id === 'finding-your-way' ? (
								<a href={shot.src.src} target="_blank" rel="noopener noreferrer" class="fyw-shot block focus-visible:outline-2 focus-visible:outline-primary-container" aria-label={`View full screenshot: ${shot.alt ?? `image ${idx + 1}`}`}>
									<Screenshot src={shot.src} alt={shot.alt ?? ""} loading={idx === 0 ? "eager" : "lazy"} />
									{shot.alt && <span class="block font-display uppercase tracking-[0.14em] text-[10px] text-on-surface-variant mt-3 mb-1 px-1">{shot.alt}</span>}
								</a>
							) : (
								<>
									<Screenshot src={shot.src} alt={shot.alt ?? ""} loading={idx === 0 ? "eager" : "lazy"} />
									{shot.alt && <p class="font-display uppercase tracking-[0.2em] text-[10px] text-on-surface-variant mt-3 mb-1 px-1">{shot.alt}</p>}
								</>
							)}
						</li>
					))}
				</ul>
			</section>
		)}


	</article>

	<script>
		import { navigate } from 'astro:transitions/client';

		// Tag <html data-nav-dir="prev|next"> before a prev/next click so
		// the view-transition CSS picks the matching slide animation.
		// Re-applied at astro:before-preparation + astro:after-swap because
		// Astro's swap nukes <html> attributes mid-flight.
		let pendingDir = null;

		const setDir = (dir) => {
			pendingDir = dir;
			document.documentElement.dataset.navDir = dir;
		};

		document.addEventListener('astro:before-preparation', () => {
			// Re-assert the pending direction (Astro's swap nukes <html> attrs).
			// Also clear any stale direction from the *previous* navigation so a
			// rapid prev→next→prev sequence never applies the wrong slide.
			if (pendingDir) {
				document.documentElement.dataset.navDir = pendingDir;
			} else {
				delete document.documentElement.dataset.navDir;
			}
		});
		document.addEventListener('astro:after-swap', () => {
			if (pendingDir) document.documentElement.dataset.navDir = pendingDir;
		});
		document.addEventListener('astro:page-load', () => {
			pendingDir = null;
			delete document.documentElement.dataset.navDir;
		});

		// Delegated; capture phase so we set data-nav-dir before
		// ClientRouter's own click interceptor snapshots the old page.
		document.addEventListener('click', (e) => {
			const a = e.target && e.target.closest && e.target.closest('a[aria-label^="Previous:"], a[aria-label^="Next:"]');
			if (!a) return;
			setDir(a.getAttribute('aria-label').startsWith('Previous') ? 'prev' : 'next');
		}, true);

		// Touch swipe: horizontal pan ≥ 60px on the article navigates to
		// prev (swipe right) or next (swipe left). Ignores vertical
		// scrolls so the page can still scroll normally. Touches starting
		// within EDGE_GUARD of either viewport edge are skipped so the
		// iOS Safari back/forward edge gesture isn't fighting us.
		const SWIPE_MIN = 60;
		const SWIPE_MAX_OFF_AXIS = 40;
		const EDGE_GUARD = 24;
		let touchStart = null;

		document.addEventListener('touchstart', (e) => {
			if (e.touches.length !== 1) return;
			const article = e.target && e.target.closest && e.target.closest('article');
			if (!article) return;
			const t = e.touches[0];
			if (t.clientX < EDGE_GUARD || t.clientX > window.innerWidth - EDGE_GUARD) return;
			touchStart = { x: t.clientX, y: t.clientY };
		}, { passive: true });

		document.addEventListener('touchend', (e) => {
			if (!touchStart) return;
			const t = e.changedTouches[0];
			const dx = t.clientX - touchStart.x;
			const dy = t.clientY - touchStart.y;
			touchStart = null;
			if (Math.abs(dy) > SWIPE_MAX_OFF_AXIS) return;
			if (Math.abs(dx) < SWIPE_MIN) return;
			const dir = dx > 0 ? 'prev' : 'next';
			const label = dir === 'prev' ? 'Previous' : 'Next';
			const a = document.querySelector(`a[aria-label^="${label}:"]`);
			const href = a && a.getAttribute('href');
			if (!href) return;
			setDir(dir);
			navigate(href);
		}, { passive: true });
	</script>

	<style>
		.prose :global(h2) {
			font-family: var(--font-display);
			font-size: 24px;
			line-height: 1.3;
			font-weight: 600;
			letter-spacing: -0.01em;
			color: var(--color-on-surface);
			margin: 2.25rem 0 1rem;
			text-transform: uppercase;
		}
		.prose :global(h3) {
			font-family: var(--font-display);
			font-size: 18px;
			line-height: 1.4;
			font-weight: 600;
			color: var(--color-on-surface);
			margin: 2rem 0 0.75rem;
		}
		.prose :global(p) {
			font-family: var(--font-body);
			font-size: 16px;
			line-height: 1.7;
			color: var(--color-secondary);
			margin: 0 0 1.25em;
		}
		.prose :global(a) {
			color: var(--color-primary-container);
			text-decoration-color: color-mix(in srgb, var(--color-primary-container) 30%, transparent);
			text-decoration-line: underline;
			text-underline-offset: 3px;
			transition: color 150ms ease, text-decoration-color 150ms ease;
		}
		.prose :global(a:hover) {
			text-decoration-color: var(--color-primary-container);
		}
		.prose :global(a.download-cta) {
			display: inline-flex;
			align-items: center;
			min-height: 48px;
			padding: 0.75rem 1.25rem;
			background: var(--color-primary-container);
			color: var(--color-on-primary-container);
			font-family: var(--font-display);
			font-weight: 700;
			text-decoration: none;
		}
		.prose :global(a.download-cta:hover) {
			background: var(--color-primary);
		}
		.prose :global(a.download-cta:focus-visible) {
			outline: 2px solid var(--color-primary-container);
			outline-offset: 3px;
		}
		.prose :global(a[data-external])::after {
			content: "";
			display: inline-block;
			width: 0.7em;
			height: 0.7em;
			margin-left: 0.18em;
			vertical-align: 0.05em;
			background-color: currentColor;
			-webkit-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M7 17 17 7'/><path d='M8 7h9v9'/></svg>") no-repeat center / contain;
			mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M7 17 17 7'/><path d='M8 7h9v9'/></svg>") no-repeat center / contain;
			opacity: 0.75;
		}
		.prose :global(ul),
		.prose :global(ol) {
			font-family: var(--font-body);
			color: var(--color-secondary);
			margin: 0 0 1.25em;
			padding-left: 1.5rem;
		}
		.prose :global(li) {
			margin: 0.35em 0;
			line-height: 1.65;
		}
		.prose :global(li::marker) {
			color: var(--color-primary-container);
		}
		.prose :global(ul.icon-list) {
			list-style: none;
			padding-left: 0;
			margin: 1.75em 0;
			display: grid;
			gap: 1.75rem;
		}
		.prose :global(ul.icon-list > li) {
			display: grid;
			grid-template-columns: 48px 1fr;
			column-gap: 1.25rem;
			align-items: start;
			margin: 0;
		}
		.prose :global(.icon-tile) {
			display: grid;
			place-items: center;
			width: 48px;
			height: 48px;
			border-radius: 12px;
			background: var(--color-surface-container-low);
			color: var(--color-primary-container);
		}
		.prose :global(blockquote) {
			border-left: 2px solid var(--color-primary-container);
			padding-left: 1.25rem;
			margin: 1.5em 0;
			color: var(--color-on-surface-variant);
			font-style: italic;
		}
		.prose :global(code) {
			font-family: var(--font-mono);
			font-size: 0.9em;
			background: var(--color-surface-container);
			border: 1px solid color-mix(in srgb, var(--color-primary-container) 10%, transparent);
			padding: 0.15em 0.4em;
			border-radius: var(--radius-DEFAULT);
			color: var(--color-primary-fixed);
		}
		.prose :global(pre) {
			background: var(--color-surface-container-low);
			border: 1px solid color-mix(in srgb, var(--color-primary-container) 15%, transparent);
			padding: 1rem 1.25rem;
			overflow-x: auto;
			margin: 1.5em 0;
			border-radius: var(--radius-DEFAULT);
		}
		.prose :global(pre code) {
			background: transparent;
			border: none;
			padding: 0;
			color: var(--color-on-surface);
		}
		.prose :global(hr) {
			border: 0;
			border-top: 1px solid var(--color-outline-variant);
			margin: 2.5em 0;
		}
		.prose :global(img) {
			max-width: 100%;
			height: auto;
			border: 1px solid var(--color-outline-variant);
			margin: 1.5em 0;
		}
		.prose :global(.bga-demo) {
			margin: 1.5em 0 1em;
		}
		.prose :global(.bga-demo-stage) {
			position: relative;
			aspect-ratio: 16 / 9;
			overflow: hidden;
			background: var(--color-grey-900);
			border: 1px solid var(--color-outline-variant);
		}
		.prose :global(.bga-demo-launch) {
			position: absolute;
			inset: 0;
			display: block;
			transition: opacity 240ms ease;
		}
		.prose :global(.bga-demo-launch[hidden]) {
			display: none;
		}
		.prose :global(.bga-demo-launch img) {
			display: block;
			width: 100%;
			height: 100%;
			object-fit: cover;
			margin: 0;
			border: 0;
		}
		.prose :global(.bga-demo-play) {
			position: absolute;
			top: 50%;
			left: 50%;
			display: grid;
			place-items: center;
			width: clamp(4.5rem, 11vw, 6.5rem);
			aspect-ratio: 1;
			border-radius: 50%;
			background: var(--color-primary-container);
			color: var(--color-grey-900);
			box-shadow: 0 0.65rem 2rem rgb(0 0 0 / 45%);
			transform: translate(-50%, -50%);
			transition: transform 180ms ease, box-shadow 180ms ease;
		}
		.prose :global(.bga-demo-play svg) {
			width: 43%;
			height: 43%;
			margin-left: 0.25rem;
		}
		.prose :global(.bga-demo-launch:hover .bga-demo-play),
		.prose :global(.bga-demo-launch:focus-visible .bga-demo-play) {
			transform: translate(-50%, -50%) scale(1.08);
			box-shadow: 0 0.85rem 2.4rem rgb(0 0 0 / 55%);
		}
		.prose :global(.bga-demo-launch:focus-visible) {
			outline: 3px solid var(--color-primary-container);
			outline-offset: -3px;
		}
		.prose :global(.bga-demo video) {
			position: absolute;
			inset: 0;
			display: block;
			width: 100%;
			height: 100%;
			background: var(--color-grey-900);
			border: 0;
			opacity: 0;
			pointer-events: none;
			transition: opacity 240ms ease;
		}
		.prose :global(.bga-demo video[hidden]) {
			display: none;
		}
		.prose :global(.bga-demo-stage[data-revealed="true"] video) {
			opacity: 1;
			pointer-events: auto;
		}
		.prose :global(.bga-demo-stage[data-revealed="true"] .bga-demo-launch) {
			opacity: 0;
			pointer-events: none;
		}
		@media (prefers-reduced-motion: reduce) {
			.prose :global(.bga-demo-launch),
			.prose :global(.bga-demo-play),
			.prose :global(.bga-demo video) {
				transition: none;
			}
		}
		.prose :global(.bga-demo figcaption) {
			margin-top: 0.75em;
			font-size: 0.875em;
			color: var(--color-on-surface-variant);
		}
		.prose :global(strong) {
			color: var(--color-on-surface);
			font-weight: 600;
		}

		.catalogue-nav {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 0.5rem;
			margin-bottom: 2.5rem;
		}
		.side-nav-inline {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			padding: 0.5rem 0.75rem;
			background: rgba(61, 56, 51, 0.55);
			border: 1px solid rgba(255, 255, 255, 0.06);
			border-radius: 12px;
			color: var(--color-on-surface-variant);
			backdrop-filter: blur(6px);
			transition: background 180ms ease, color 180ms ease, padding 180ms ease,
				border-color 180ms ease;
			text-decoration: none;
		}
		.side-nav-inline:hover {
			background: color-mix(in srgb, var(--color-primary-container) 18%, transparent);
			border-color: color-mix(in srgb, var(--color-primary-container) 45%, transparent);
			color: var(--color-on-surface);
			padding: 0.5rem 1rem;
		}
