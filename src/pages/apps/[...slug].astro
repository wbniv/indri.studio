<script>
	const installCommand = 'npm i @wbniv/bsnes-jg-player';
	function bindNpmCopy() {
		for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-install]')) {
			if (button.dataset.bound === 'true') continue;
			button.dataset.bound = 'true';
			button.addEventListener('click', async () => {
				const status = button.parentElement?.querySelector<HTMLElement>('[data-copy-install-status]');
				try {
					await navigator.clipboard.writeText(installCommand);
					if (status) { status.textContent = 'Copied!'; status.classList.add('visible'); window.setTimeout(() => status.classList.remove('visible'), 1300); }
				} catch { if (status) { status.textContent = 'Copy unavailable'; status.classList.add('visible'); window.setTimeout(() => status.classList.remove('visible'), 1800); } }
			});
		}
	}
	bindNpmCopy();
	document.addEventListener('astro:page-load', bindNpmCopy);
</script>
