---
// Erawan landing page — implements docs/plans/2026-11-12-erawan-landing-page-visual-plan-v2.md
// ("situations first") and, on top of it, the v4 plan's animated simulations (ErawanSimulation)
// and the v3 background shortlist (ErawanMotion), all in the Erawan repo, carrying over the revisions Will accepted on the
// published v1 page: the site's own palette, status pills in the matrix, and a Source link
// with the GitHub mark. Navigation and every example work without JavaScript: the situation
// choosers are native radio groups styled with CSS, and without CSS scripting support
// (<noscript>) all twelve examples are shown. Interface excerpts are enlarged fragments of
// the real renderers drawn from labelled demo data (see scripts/sync-erawan-docs.sh).
import AppLayout from "../../../layouts/AppLayout.astro";
import ErawanCap from "../../../components/ErawanCap.astro";
import ErawanMotion from "../../../components/ErawanMotion.astro";
import ErawanSimulation from "../../../components/ErawanSimulation.astro";

const quickStart = "/docs/erawan-quick-start/";
const a4 = "/apps/erawan/erawan-a4.pdf";
const repo = "https://github.com/wbniv/erawan";
// GitHub mark (Octicons mark-github, 16x16).
const githubMark = "M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z";

// Twelve featured situations, four per workflow, chosen from the 60-example idea bank
// (IDs refer to that bank). Every file name and path is fictional.
const workflows = [
	{
		id: "backup",
		tone: "blue",
		title: "Back up & watch",
		join: "to",
		joinGlyph: "→",
		guide: { label: "Open the backup guide", href: `${quickStart}#backup` },
		situations: [
			{ id: "B01", chip: "Photos → USB", title: "Give photos a second home", from: "Photos on laptop", to: "Mounted USB /Photos", review: "Choose folders + exclusions", flow: "Copy → content check", result: "A verified second copy", note: "Local destination: directory below a non-root mount." },
			{ id: "B04", chip: "Overnight upload", title: "See the overnight upload", from: "Local video archive", to: "S3 bucket /video", review: "Window 22:00–07:00 + rate limit", flow: "Copy in window → verify", result: "Watch copying or waiting", note: "A run window controls an already-started job." },
			{ id: "B06", chip: "SFTP → SFTP", title: "One server to another", from: "SFTP A /srv/photos", to: "SFTP B /srv/archive", review: "Review both configured remotes", flow: "Erawan copies → verifies", result: "Inspect the destination result", note: "SFTP route; transfer is not promised to bypass Erawan." },
			{ id: "B15", chip: "Resume job", title: "Resume an interrupted job", from: "Saved backup job", to: "Same bound destination", review: "Review saved job + selection", flow: "Restart → remaining work", result: "Follow resumed progress", note: "Interrupted-file behavior depends on transport." },
		],
	},
	{
		id: "consolidate",
		tone: "green",
		title: "Compare & consolidate",
		join: "to",
		joinGlyph: "→",
		guide: { label: "Open the consolidation guide", href: `${quickStart}#consolidate` },
		situations: [
			{ id: "C01", chip: "Old laptop", title: "Bring in the old laptop", from: "Old laptop /Documents", to: "Local KEEP /Archive", review: "Review missing files + conflicts", flow: "Copy missing → verify", result: "One retained collection", note: "File consolidation; not migration of application settings." },
			{ id: "C02", chip: "Scattered photos", title: "Gather scattered photos", from: "USB A + USB B folders", to: "Local KEEP /Photos", review: "Choose KEEP; inspect overlap", flow: "Review → apply → verify", result: "Collections brought together", note: "Use selected, non-overlapping roots." },
			{ id: "C05", chip: "Partial copy", title: "Finish a partial copy", from: "Original collection", to: "Part-filled local KEEP", review: "Review gaps against original", flow: "Copy missing → verify", result: "Inspect completed coverage", note: "Different bytes at the same path remain conflicts." },
			{ id: "C16", chip: "Conflicting names", title: "Keep both conflicting files", from: "FROM proposal.pdf", to: "KEEP proposal.pdf", review: "Different bytes → choose new name", flow: "Approve proposal-client-b.pdf", result: "Both versions retained", note: "A fresh path is a reviewed resolution, not an automatic winner." },
		],
	},
	{
		id: "duplicates",
		tone: "purple",
		title: "Find repeated files",
		join: "and",
		joinGlyph: "=",
		guide: { label: "Open the duplicate guide", href: `${quickStart}#duplicates` },
		situations: [
			{ id: "D01", chip: "Camera imports", title: "Repeated camera imports", from: "Photos/beach.jpg", to: "Imports/IMG_0421.jpg", review: "Full hash matches → choose keeper", flow: "Save review → dry run", result: "Delete eligible extra if chosen", note: "Exact bytes; similar-looking images are separate." },
			{ id: "D02", chip: "Downloads twice", title: "Downloads saved twice", from: "Downloads/setup.iso", to: "Old/setup (1).iso", review: "Inspect identical full hashes", flow: "Choose keeper → preview action", result: "Remove a reviewed extra", note: "Scan selected local roots; action is optional." },
			{ id: "D03", chip: "Old backups", title: "Repeats in backup folders", from: "Backup-1 selected folder", to: "Backup-2 selected folder", review: "Inspect groups + repeated bytes", flow: "Keep backup redundancy? → decide", result: "Retain or remove deliberately", note: "Identical files may be intentionally separate backups." },
			{ id: "D04", chip: "Worktrees", title: "Copies across worktrees", from: "Worktree A eligible file", to: "Worktree B identical file", review: "Review keeper + link eligibility", flow: "Dry run → apply link", result: "Keep paths; share file content", note: "Same filesystem and compatible attributes; linked files are read-only." },
		],
	},
] as const;

const matrix = [
	["Local folders & mounted disks", "Yes", "Yes*", "Includes mounted USB drives and shares"],
	["SFTP servers (over SSH)", "Yes", "Yes", "One configured SFTP server to another"],
	["Cloudflare R2 & Amazon S3", "Yes", "Yes", "To: a dedicated prefix inside a bucket"],
	["SMB, WebDAV & FTP", "Yes", "Yes", "Configured rclone routes; backend evidence varies"],
	["Running Docker containers", "Yes", "Yes", "Filesystem accessible from this host"],
	["Google Drive", "Yes†", "Planned", "Read-only source setup"],
	["Other rclone remotes", "Check", "Check", "Backend-specific validation needed"],
	["Linux SSH peer (rsync)", "No", "Yes", "Requires a local source"],
] as const;

const routes = [
	{ name: "Backup", choose: "Source + destination + options", review: "Printed plan / run command", act: "Start backup; open watch", result: "Inspect verification result" },
	{ name: "Consolidate", choose: "Roots + one KEEP", review: "Missing files + conflict decisions", act: "Run reviewed apply command", result: "Inspect retained content / report" },
	{ name: "Duplicates", choose: "Local roots + minimum size", review: "Scan → groups → keeper / actions", act: "Save → dry run → optional apply", result: "Inspect journal / undo route" },
] as const;
---

<AppLayout
	title="Erawan"
	description="A visual terminal tool for backing up files, consolidating folders, and finding duplicates — with verification in plain view."
>
	<div class="erawan">
		<noscript>
			<style>
				.e-situ input, .e-chip { display: none !important; }
				.e-situ .e-panel { display: block !important; margin-bottom: 14px; }
			</style>
		</noscript>

		<header class="e-top">
			<a class="e-mark" href="/apps/erawan/">Erawan</a>
			<nav aria-label="Erawan">
				<a href="#situations">Situations</a>
				<a href={quickStart}>Quick Start</a>
				<a class="e-source" href={repo} rel="noopener"><svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d={githubMark} /></svg> Source</a>
			</nav>
		</header>

		<section class="e-hero" aria-labelledby="e-title">
			<div class="e-hero-copy">
				<h1 id="e-title">See your files move.<br />Know what was verified.</h1>
				<p class="e-lede">A visual terminal tool for backing up files, consolidating folders, and finding duplicates.</p>
				<p class="e-actions">
					<a class="e-btn e-btn-primary" href={quickStart}>Read Quick Start</a>
					<a class="e-btn e-btn-quiet" href="#situations">Explore situations</a>
				</p>
				<p class="e-status">Linux · Python 3.10+ · development software</p>
			</div>
			<figure class="e-hero-shot">
				<img
					src="/apps/erawan/watch-detail.svg"
					width="358"
					height="146"
					alt="Erawan's live backup view, enlarged: 162 of 240 paths done on a blue-to-cyan bar, 544 of 800 MiB on an amber-to-green bar, 3 active files at 20.7 MiB per second."
					fetchpriority="high"
				/>
				<figcaption>Actual gradient detail · illustrative demo data · <a href={`${quickStart}#backup`}>See the full view →</a></figcaption>
			</figure>
			<ErawanMotion />
		</section>

		<nav class="e-pick" aria-label="Choose your workflow">
			<h2>Choose your workflow</h2>
			<ul>
				<li><a href="#backup">Back up</a></li>
				<li><a href="#consolidate">Consolidate</a></li>
				<li><a href="#duplicates">Duplicates</a></li>
			</ul>
		</nav>

		<section id="situations" class="e-situations" aria-labelledby="e-situations-title">
			<p class="e-kicker">Versatile</p>
			<h2 id="e-situations-title">Pick a situation you recognize.</h2>

			{workflows.map((w) => (
				<article id={w.id} class={`e-wf e-${w.tone}`} aria-labelledby={`${w.id}-title`}>
					<h3 id={`${w.id}-title`}>{w.title}</h3>
					<fieldset class="e-situ">
						<legend class="sr-only">Pick a {w.title} situation</legend>
						{w.situations.map((s, i) => (
							<input type="radio" name={`situ-${w.id}`} id={`situ-${s.id}`} checked={i === 0} />
						))}
						<div class="e-left">
							<div class="e-chips">
								{w.situations.map((s) => (
									<label class="e-chip" for={`situ-${s.id}`}>{s.id} · {s.chip}</label>
								))}
							</div>
							<p class="e-hint">Choose an example to see its locations, review decision, and possible result.</p>
							<p class="e-guide"><a href={w.guide.href}>{w.guide.label} →</a></p>
						</div>
						<div class="e-panels">
							{w.situations.map((s) => (
								<section class="e-panel" aria-labelledby={`panel-${s.id}`}>
									<h4 id={`panel-${s.id}`}>{s.id} · {s.title}</h4>
									<div class="e-ends">
										<p class="e-end">{s.from}</p>
										<span class="e-join" aria-hidden="true">{w.joinGlyph}</span>
										<span class="sr-only">{w.join}</span>
										<p class="e-end">{s.to}</p>
									</div>
									<div class="e-review">
										<p class="e-review-label">Review</p>
										<p>{s.review}</p>
									</div>
									<p class="e-flow"><span aria-hidden="true">↓</span> {s.flow}</p>
									<p class="e-result"><span aria-hidden="true">→</span> {s.result}</p>
									<p class="e-note">{s.note}</p>
								</section>
							))}
						</div>
						<ErawanSimulation family={w.id} />
					</fieldset>
				</article>
			))}
			<p class="e-fine">Illustrative scenarios with fictional files, not application screens. File operations happen in the local application, never in the browser.</p>
		</section>

		<section class="e-matrix" aria-labelledby="e-matrix-title">
			<h2 id="e-matrix-title">Backup connectivity</h2>
			<p class="e-sub">Source and destination support, with the important distinctions visible. Other workflows have different coverage.</p>
			<table>
				<thead>
					<tr><th scope="col">Endpoint type</th><th scope="col">From</th><th scope="col">To</th></tr>
				</thead>
				<tbody>
					{matrix.map(([type, from, to]) => (
						<tr>
							<th scope="row">{type}</th>
							<td><ErawanCap value={from} /></td>
							<td><ErawanCap value={to} /></td>
						</tr>
					))}
				</tbody>
			</table>
			<p class="e-fine">* Local destinations: below a non-root mount. † Drive source verification is in progress. Routes are not an exhaustive tested-pair list.</p>
			<p class="e-legend"><span aria-hidden="true">✓</span> supported · Planned = not yet · <span aria-hidden="true">?</span> Check = validate your remote first · <span aria-hidden="true">—</span> not supported</p>
			<details class="e-endpoint-details">
				<summary><span class="e-show">Show endpoint details ↓</span><span class="e-hide">Hide endpoint details ↑</span></summary>
				<dl>
					{matrix.map(([type, , , detail]) => (
						<div><dt>{type}</dt><dd>{detail}</dd></div>
					))}
				</dl>
				<p>SFTP → SFTP uses two configured rclone remotes. <code>ssh://</code> selects the separate rsync route, which needs a local source. <a href={`${quickStart}#backup`}>Endpoint guide →</a></p>
			</details>
		</section>

		<section class="e-wizard" aria-labelledby="e-visual-title">
			<div class="e-split">
				<div>
					<p class="e-kicker">Visual</p>
					<h2 id="e-visual-title">Start in the wizard.</h2>
					<p>Choose a task, your locations, and options. Review the next action before changing files.</p>
					<ul class="e-plain">
						<li>Backup / consolidation → review printed commands</li>
						<li>Duplicates → scan and review groups</li>
					</ul>
				</div>
				<figure>
					<img
						src="/apps/erawan/wizard-choices.svg"
						width="358"
						height="140"
						loading="lazy"
						alt="Erawan wizard, Choose a task: Back up one source (highlighted), Compare and consolidate directories, Find duplicate files."
					/>
					<figcaption>Current task menu · actual renderer</figcaption>
				</figure>
			</div>
			<table class="e-routes">
				<caption>The routes lead to different next actions. Review the local result before you apply.</caption>
				<thead>
					<tr><th scope="col">Route</th><th scope="col">Choose</th><th scope="col">Review</th><th scope="col">Act</th><th scope="col">Result</th></tr>
				</thead>
				<tbody>
					{routes.map((r) => (
						<tr>
							<th scope="row">{r.name}</th>
							<td data-label="Choose">{r.choose}</td>
							<td data-label="Review">{r.review}</td>
							<td data-label="Act">{r.act}</td>
							<td data-label="Result">{r.result}</td>
						</tr>
					))}
				</tbody>
			</table>
		</section>

		<section class="e-split e-split-flip" aria-labelledby="e-verified-title">
			<figure>
				<img
					src="/apps/erawan/verification-excerpt.svg"
					width="358"
					height="146"
					loading="lazy"
					alt="Erawan's verification view, enlarged: 172 of 240 files verified on a cyan-green bar, 1.1 of 1.6 GiB of content read on a purple-to-cyan bar, verification in progress."
				/>
				<figcaption>Verification excerpt · demo data</figcaption>
			</figure>
			<div>
				<p class="e-kicker">Verified</p>
				<h2 id="e-verified-title">Copying finishes. Verification follows.</h2>
				<p>Read the outcome: copied content, checked content, and any unresolved findings.</p>
				<p class="e-fine">Content checks and filesystem metadata fidelity answer different questions.</p>
				<p><a href={`${quickStart}#backup`}>Read verification and fidelity details →</a></p>
			</div>
		</section>

		<section class="e-cta" aria-labelledby="e-cta-title">
			<h2 id="e-cta-title">Choose your first job.</h2>
			<p>Set up from source on Linux, then open <code>erawan wizard</code>. There is no public download yet; the <a href={repo} rel="noopener">source repository</a> is private for now.</p>
			<p class="e-actions">
				<a class="e-btn e-btn-primary" href={quickStart}>Read Quick Start</a>
				<a class="e-btn e-btn-light" href={a4} download>A4 overview · two pages</a>
			</p>
		</section>

		<footer class="e-foot">
			Erawan · MIT · <a class="e-source" href={repo} rel="noopener"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path fill="currentColor" d={githubMark} /></svg> Source</a> · <a href={quickStart}>Quick Start</a>
		</footer>
	</div>
</AppLayout>

<style>
	/* Site-matched: the page inherits the indri.studio surface and tokens.
	   Only the product's own gradient accents and terminal colours are local. */
	.erawan {
		--e-ink: var(--color-on-surface);
		--e-muted: var(--color-on-surface-variant);
		--e-panel: var(--color-surface-container-lowest);
		--e-card: var(--color-surface-container);
		--e-row: var(--color-surface-container-low);
		--e-btn: var(--color-surface-container-high);
		--e-btn-hover: var(--color-surface-container-highest);
		--e-accent: var(--color-primary-container);
		--e-on-accent: var(--color-on-primary-container);
		/* Erawan's interface gradients, one per workflow */
		--e-blue: #23a7c4;
		--e-green: #43b88c;
		--e-purple: #9875e6;
		/* Terminal-panel colours */
		--e-term-label: #87dbc9;
		--e-term-dim: #b9cce1;
		color: var(--e-ink);
		font-family: var(--font-body);
		line-height: 1.55;
		width: 100%;
		padding: 0 max(16px, calc((100% - 1312px) / 2)) 48px;
		font-size: 16px;
	}
	.erawan :global(a) { color: var(--e-accent); }
	.erawan :global(a:focus-visible) { outline: 3px solid var(--e-accent); outline-offset: 3px; border-radius: 4px; }
	.erawan code { font-family: var(--font-mono); font-size: 0.92em; }
	.erawan h1, .erawan h2, .erawan h3, .erawan h4 { font-family: var(--font-display); color: var(--e-ink); letter-spacing: -0.01em; font-weight: 700; margin: 0; }

	.e-top { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding: 28px 0 8px; }
	.e-mark { font-family: var(--font-display); font-weight: 700; font-size: 28px; color: var(--e-ink) !important; text-decoration: none; letter-spacing: 0; }
	.e-top nav { display: flex; flex-wrap: wrap; gap: 8px 28px; align-items: center; }
	.e-top nav a { color: var(--e-ink); text-decoration: none; padding: 8px 0; }
	.e-top nav a:hover { color: var(--e-accent); }
	.e-source { display: inline-flex; align-items: center; gap: 7px; }
	.e-source svg { flex: none; }

	.e-hero { position: relative; isolation: isolate; display: grid; grid-template-columns: 1.05fr 1fr; gap: 48px; align-items: center; padding: 48px 0 56px; }
	.e-hero-copy, .e-hero-shot { position: relative; z-index: 1; }
	.e-hero h1 { font-size: clamp(32px, 4.4vw, 52px); line-height: 1.15; }
	.e-lede { font-size: clamp(18px, 1.8vw, 21px); margin: 20px 0 28px; max-width: 34ch; color: var(--e-ink); }
	.e-actions { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin: 0; }
	.e-btn { display: inline-flex; align-items: center; min-height: 48px; padding: 0 20px; border-radius: 6px; font-weight: 700; font-size: 15px; text-decoration: none; }
	.e-btn-primary { background: var(--e-accent); color: var(--e-on-accent) !important; }
	.e-btn-primary:hover { background: var(--color-primary); }
	.e-btn-quiet, .e-btn-light { background: var(--e-btn); color: var(--e-ink) !important; }
	.e-btn-quiet:hover, .e-btn-light:hover { background: var(--e-btn-hover); }
	.e-status { color: var(--e-muted); font-size: 14px; margin: 16px 0 0; }
	.e-hero-shot { margin: 0; }
	.e-hero-shot img, .e-split img { display: block; width: 100%; height: auto; border-radius: 22px; }
	.e-hero-shot figcaption, .e-split figcaption { margin-top: 10px; font-size: 14px; color: var(--e-muted); }

	.e-pick { display: none; }

	.e-kicker { color: var(--e-accent); font-size: 13px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; margin: 0 0 6px; }
	.e-situations { padding-top: 8px; scroll-margin-top: 80px; display: flex; flex-direction: column; gap: 26px; }
	.e-situations > h2 { font-size: clamp(26px, 3vw, 34px); margin-bottom: -2px; }

	/* One panel per workflow: a 2x2 chooser on the left, the chosen example on the right. */
	.e-wf { background: var(--e-card); border-top: 4px solid var(--e-blue); border-radius: 4px 4px 12px 12px; padding: 24px 24px 28px; scroll-margin-top: 80px; }
	.e-green { border-top-color: var(--e-green); }
	.e-purple { border-top-color: var(--e-purple); }
	.e-wf > h3 { font-size: clamp(22px, 2.4vw, 28px); margin-bottom: 18px; }
	.e-situ { border: 0; margin: 0; padding: 0; min-width: 0; position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 24px; align-items: start; }
	.e-left { min-width: 0; }
	.e-chips { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 14px; }
	.e-situ input { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; pointer-events: none; }
	.e-chip { display: flex; align-items: center; min-height: 48px; padding: 6px 14px; border-radius: 6px; background: var(--e-btn); color: var(--e-ink); font-size: 15px; line-height: 1.3; cursor: pointer; }
	.e-chip:hover { background: var(--e-btn-hover); }
	/* The Nth radio selects the Nth chip and the Nth panel. */
	.e-situ input:nth-of-type(1):checked ~ .e-left .e-chip:nth-child(1),
	.e-situ input:nth-of-type(2):checked ~ .e-left .e-chip:nth-child(2),
	.e-situ input:nth-of-type(3):checked ~ .e-left .e-chip:nth-child(3),
	.e-situ input:nth-of-type(4):checked ~ .e-left .e-chip:nth-child(4) { background: var(--e-accent); color: var(--e-on-accent); font-weight: 700; }
	.e-situ input:nth-of-type(1):focus-visible ~ .e-left .e-chip:nth-child(1),
	.e-situ input:nth-of-type(2):focus-visible ~ .e-left .e-chip:nth-child(2),
	.e-situ input:nth-of-type(3):focus-visible ~ .e-left .e-chip:nth-child(3),
