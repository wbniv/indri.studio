<style>
	.e-terms {
		color: var(--color-on-surface);
		font-family: var(--font-body);
		font-size: 16px;
		line-height: 1.65;
		width: 100%;
		max-width: 760px;
		margin: 0 auto;
		padding: 28px 16px 64px;
	}
	.e-terms a { color: var(--color-primary-container); }
	.e-terms a:focus-visible { outline: 3px solid var(--color-primary-container); outline-offset: 3px; border-radius: 4px; }
	.e-terms h1, .e-terms h2 { font-family: var(--font-display); font-weight: 700; letter-spacing: -0.01em; }
	.e-terms h1 { font-size: 34px; margin: 12px 0 4px; }
	.e-terms h2 { font-size: 21px; margin: 32px 0 8px; }
	.e-terms p { margin: 0 0 14px; }
	.e-terms ul { margin: 0 0 14px; padding-left: 22px; list-style: disc; }
	.e-terms li { margin: 0 0 8px; }
	.e-back { margin: 0; }
	.e-back a { text-decoration: none; }
	.e-date { color: var(--color-on-surface-variant); font-size: 14px; }

 .e-license { padding: 20px; margin: 18px 0; border: 1px solid var(--color-outline-variant); border-radius: 10px; font-size: 14px; overflow-wrap: anywhere; }
</style>
